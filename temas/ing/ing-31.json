{"curso": "Inglés", "tema": "31. Some / Any", "leccion": [{"t": "teoria", "titulo": "Some", "regla": "some = algo de / unos. Se usa en frases afirmativas: I have some water. I want some apples.", "ejemplos": [{"en": "I have some water.", "es": "Tengo algo de agua."}, {"en": "I want some apples.", "es": "Quiero unas manzanas."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I have ___ bread.", "respuestas": ["some"], "explicacion": "Afirmativa → some.", "t": "ej", "id": "n31-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "We want ___ apples.", "respuestas": ["some"], "explicacion": "Afirmativa → some.", "t": "ej", "id": "n31-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Tengo algo de agua.", "respuestas": ["I have some water."], "explicacion": "have + some + sustantivo.", "t": "ej", "id": "n31-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Quiero unos huevos.", "respuestas": ["I want some eggs."], "explicacion": "want + some + sustantivo.", "t": "ej", "id": "n31-s01-e04"}, {"t": "teoria", "titulo": "Any", "regla": "any se usa en negativas y preguntas: I don't have any water. Do you have any water?", "ejemplos": [{"en": "I don't have any milk.", "es": "No tengo leche."}, {"en": "Do you have any eggs?", "es": "¿Tienes huevos?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I don't have ___ milk.", "respuestas": ["any"], "explicacion": "Negativa → any.", "t": "ej", "id": "n31-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "Do you have ___ eggs?", "respuestas": ["any"], "explicacion": "Pregunta → any.", "t": "ej", "id": "n31-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No tengo pan.", "respuestas": ["I don't have any bread.", "I do not have any bread."], "explicacion": "don't + any.", "t": "ej", "id": "n31-s02-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Tienes agua?", "r
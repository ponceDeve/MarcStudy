{"curso": "Inglés", "tema": "85. Pasado Simple Irregular", "leccion": [{"t": "teoria", "titulo": "Irregulares 1", "regla": "No llevan -ed, cambian: go → went, eat → ate, see → saw, have → had.", "ejemplos": [{"en": "I went home.", "es": "Fui a casa."}, {"en": "She ate rice.", "es": "Ella comió arroz."}, {"en": "We saw him.", "es": "Lo vimos."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: go", "respuestas": ["went"], "explicacion": "irregular.", "t": "ej", "id": "n85-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: eat", "respuestas": ["ate"], "explicacion": "irregular.", "t": "ej", "id": "n85-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: see", "respuestas": ["saw"], "explicacion": "irregular.", "t": "ej", "id": "n85-s01-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: have", "respuestas": ["had"], "explicacion": "irregular.", "t": "ej", "id": "n85-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Fui a casa.", "respuestas": ["I went home."], "explicacion": "went.", "t": "ej", "id": "n85-s01-e05"}, {"t": "teoria", "titulo": "Irregulares 2", "regla": "do → did, get → got, come → came, take → took, make → made.", "ejemplos": [{"en": "I took a photo.", "es": "Tomé una foto."}, {"en": "She made bread.", "es": "Ella hizo pan."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: do", "respuestas": ["did"], "explicacion": "irregular.", "t": "ej", "id": "n85-s02-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: get", "respuestas": ["got"], "explicacion": "irregular.", "t": "ej", "id": "n85-s02-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: come", "respuestas": ["came"], "explicacion": "irregular.", "t": "ej", "id": "n85-s02-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: take", "respuestas": ["took"],
{"curso": "Inglés", "tema": "25. Adjetivos: Uso Y Orden", "leccion": [{"t": "teoria", "titulo": "Antes del sustantivo", "regla": "En inglés el adjetivo va antes del sustantivo y no cambia en plural: a big house, big houses.", "ejemplos": [{"en": "It is a big house.", "es": "Es una casa grande."}, {"en": "They are big houses.", "es": "Son casas grandes."}, {"en": "It is a new car.", "es": "Es un coche nuevo."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es una casa grande.", "respuestas": ["It is a big house.", "It's a big house."], "explicacion": "a + adjetivo + sustantivo.", "t": "ej", "id": "n25-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Son casas grandes.", "respuestas": ["They are big houses.", "They're big houses."], "explicacion": "El adjetivo no cambia.", "t": "ej", "id": "n25-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es un coche nuevo.", "respuestas": ["It is a new car.", "It's a new car."], "explicacion": "a + adjetivo + sustantivo.", "t": "ej", "id": "n25-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is a ___ book. (viejo)", "respuestas": ["old"], "explicacion": "old = viejo.", "t": "ej", "id": "n25-s01-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "They are ___ cars. (rápidos)", "respuestas": ["fast"], "explicacion": "El adjetivo no cambia en plural.", "t": "ej", "id": "n25-s01-e05"}, {"t": "teoria", "titulo": "Después de to be", "regla": "Con to be el adjetivo va después: The house is big. My bag is new.", "ejemplos": [{"en": "The house is big.", "es": "La casa es grande."}, {"en": "My bag is new.", "es": "Mi bolsa es nueva."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: La casa es grande.", "respuestas": ["The house is big."], "explicacion": "sustantivo + is + adjetivo.", "t": "ej", "id": "n25-s02-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Los coches son rápidos.", "respuestas": ["The cars are fast."], "explicacion": "sustantivo + are + adjetivo.", "t": "ej", "id": "n25-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Mi bolsa es nueva.", "respuestas": ["My bag is new."], "explicacion": "sustantivo + is + adjetivo.", "t": "ej", "id": "n25-s02-e03"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: is / The / tall / man", "respuestas": ["The man is tall."], "explicacion": "the + sustantivo + is + adjetivo.", "t": "ej", "id": "n25-s02-e04"}, {"t": "teoria", "titulo": "Very y too", "regla": "very = muy: It is very big. too = demasiado (es un problema): It is too big.", "ejemplos": [{"en": "It is very big.", "es": "Es muy grande."}, {"en": "It is too small.", "es": "Es demasiado pequeño."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es muy grande.", "respuestas": ["It is very big.", "It's very big."], "explicacion": "very + adjetivo.", "t": "ej", "id": "n25-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es demasiado pequeño.", "respuestas": ["It is too small.", "It's too small."], "explicacion": "too + adjetivo.", "t": "ej", "id": "n25-s03-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ hot. (muy)", "respuestas": ["very"], "explicacion": "very = muy.", "t": "ej", "id": "n25-s03-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ expensive. (demasiado)", "respuestas": ["too"], "explicacion": "too = demasiado.", "t": "ej", "id": "n25-s03-e04"}, {"t": "teoria", "titulo": "Opuestos", "regla": "Aprende los adjetivos en pares.", "ejemplos": [{"en": "big ↔ small", "es": "grande ↔ pequeño"}, {"en": "new ↔ old", "es": "nuevo ↔ viejo"}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Opuesto de: big", "respuestas": ["small"], "explicacion": "big ↔ small.", "t": "ej", "id": "n25-s04-e01"}, {"tipo": "escribir", "su
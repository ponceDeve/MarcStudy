{"curso": "Inglés", "tema": "9. Preguntas Con Be", "leccion": [{"t": "teoria", "titulo": "What", "regla": "What = qué. Orden: What + is/are + sujeto. What is it? → It is a book.", "ejemplos": [{"en": "What is it?", "es": "¿Qué es?"}, {"en": "What is he?", "es": "¿Qué es él? (profesión)"}, {"en": "What are they?", "es": "¿Qué son ellos?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is it?", "respuestas": ["What"], "explicacion": "Qué = What.", "t": "ej", "id": "n09-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "What ___ they?", "respuestas": ["are"], "explicacion": "they → are.", "t": "ej", "id": "n09-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "What ___ she?", "respuestas": ["is"], "explicacion": "she → is.", "t": "ej", "id": "n09-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Qué es él?", "respuestas": ["What is he?", "What's he?"], "explicacion": "What + is + he.", "t": "ej", "id": "n09-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Qué son ellos?", "respuestas": ["What are they?"], "explicacion": "What + are + they.", "t": "ej", "id": "n09-s01-e05"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: is / What / it ?", "respuestas": ["What is it?"], "explicacion": "What + is + sujeto.", "t": "ej", "id": "n09-s01-e06"}, {"t": "teoria", "titulo": "Where", "regla": "Where = dónde. Where is she? Where is he from?", "ejemplos": [{"en": "Where is she?", "es": "¿Dónde está ella?"}, {"en": "Where are you from?", "es": "¿De dónde eres?"}, {"en": "Where is he from?", "es": "¿De dónde es él?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is he?", "respuestas": ["Where"], "explicacion": "Dónde = Where.", "t": "ej", "id": "n09-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "Where ___ you from?", "respuestas": ["are"], "explicacion": "you → are.", "t": "ej", "id": "n09-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Dónde está ella?", "respuestas": ["Where is she?", "Where's she?"], "explicacion": "Where + is + she.", "t": "ej", "id": "n09-s02-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿De dónde eres?", "respuestas": ["Where are you from?"], "explicacion": "Where + are + you + from.", "t": "ej", "id": "n09-s02-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿De dónde es él?", "respuestas": ["Where is he from?", "Where's he from?"], "explicacion": "Where + is + he + from.", "t": "ej", "id": "n09-s02-e05"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: from / Where / she / is ?", "respuestas": ["Where is she from?"], "explicacion": "Where + is + sujeto + from.", "t": "ej", "id": "n09-s02-e06"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde: Where is he from? (Spain)", "respuestas": ["He is from Spain.", "He's from Spain."], "explicacion": "He + is + from + país.", "t": "ej", "id": "n09-s02-e07"}, {"t": "teoria", "titulo": "Who", "regla": "Who = quién. Who is he? → He is a doctor.", "ejemplos": [{"en": "Who is he?", "es": "¿Quién es él?"}, {"en": "Who are they?", "es": "¿Quiénes son ellos?"}, {"en": "Who are you?", "es": "¿Quién eres?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is she?", "respuestas": ["Who"], "explicacion": "Quién = Who.", "t": "ej", "id": "n09-s03-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "Who ___ they?", "respuestas": ["are"], "explicacion": "they → are.", "t": "ej", "id": "n09-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Quién es él?", "respuestas": ["Who is he?", "Who's he?"], "explicacion": "Who + is + he.", "t": "ej", "id": "n09-s03-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Quiénes son ellos?", "respuestas": ["Who are they?"], "explicacion": "Who + are + they.", "t": "ej", "id": "n09-s03-e04"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: Who / are / you ?", "respuestas": ["Who are you?"], "explicacion": "Who + are + you.", "t": "ej", "id": "n09-s03-e05"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde: Who is she? (a teacher)", "respuestas": ["She is a teacher.", "She's a teacher."], "explicacion": "She + is + a teacher.", "t": "ej", "id": "n09-s03-e06"}, {"t": "teoria", "titulo": "How y How old", "regla": "How are you? → I am fine. How old = qué edad: How old are you? → I am ten.", "ejemplos": [{"en": "How are you?", "es": "¿Cómo estás?"}, {"en": "How old are you?", "es": "¿Cuántos años tienes?"}, {"en": "I am fine.", "es": "Estoy bien."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "How ___ you?", "respuestas": ["are"], "explicacion": "you → are.", "t": "ej", "id": "n09-s04-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "How ___ is she?", "respuestas": ["old"], "explicacion": "Edad = How old.", "t": "ej", "id": "n09-s04-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cómo estás?", "respuestas": ["How are you?"], "explicacion": "How + are + you.", "t": "ej", "id": "n09-s04-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuántos años tienes?", "respuestas": ["How old are you?"], "explicacion": "How old + are + you.", "t": "ej", "id": "n09-s04-e04"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde: How are you? (bien)", "respuestas": ["I am fine.", "I'm fine."], "explicacion": "I + am + fine.", "t": "ej", "id": "n09-s04-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Tengo diez años.", "respuestas": ["I am ten.", "I'm ten."], "explicacion": "I am + número.", "t": "ej", "id": "n09-s04-e06"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PREGUNTAS CON BE. No hay contenido nuevo.", "ejemplos": [], "v
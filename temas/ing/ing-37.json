{"curso": "Inglés", "tema": "37. Pronombres Objeto", "leccion": [{"t": "teoria", "titulo": "La tabla", "regla": "Van después del verbo: I like her. Cambian así: I → me, you → you, he → him, she → her, it → it, we → us, they → them. Verbos nuevos: love (amar), know (conocer, saber), see (ver).", "ejemplos": [{"en": "I like her.", "es": "Ella me gusta."}, {"en": "She knows me.", "es": "Ella me conoce."}, {"en": "We love them.", "es": "Los queremos."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: I", "respuestas": ["me"], "explicacion": "I → me.", "t": "ej", "id": "n37-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: he", "respuestas": ["him"], "explicacion": "he → him.", "t": "ej", "id": "n37-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: she", "respuestas": ["her"], "explicacion": "she → her.", "t": "ej", "id": "n37-s01-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: we", "respuestas": ["us"], "explicacion": "we → us.", "t": "ej", "id": "n37-s01-e04"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: they", "respuestas": ["them"], "explicacion": "they → them.", "t": "ej", "id": "n37-s01-e05"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: it", "respuestas": ["it"], "explicacion": "it → it.", "t": "ej", "id": "n37-s01-e06"}, {"t": "teoria", "titulo": "Después del verbo", "regla": "Sujeto + verbo + pronombre objeto. El sujeto hace la acción; el objeto la recibe.", "ejemplos": [{"en": "I see him.", "es": "Lo veo a él."}, {"en": "They like us.", "es": "Les gustamos."}, {"en": "You know me.", "es": "Tú me conoces."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I like ___. (ella)", "respuestas": ["her"], "explicacion": "ella (objeto) → her.", "t": "ej", "id": "n37-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "She likes ___. (yo)", "respuestas": ["me"], "explicacion": "yo (objeto) → me.", "t": "ej", "id": "n37-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "We know ___. (ellos)", "respuestas": ["them"], "explicacion": "ellos (objeto) → them.", "t": "ej", "id": "n37-s02-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "They like ___. (nosotros)", "respuestas": ["us"], "explicacion": "nosotros (objeto) → us.", "t": "ej", "id": "n37-s02-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Me gusta ella.", "respuestas": ["I like her."], "explicacion": "I like + her.", "t": "ej", "id": "n37-s02-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella me conoce.", "respuestas": ["She knows me."], "explicacion": "She knows + me.", "t": "ej", "id": "n37-s02-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Los queremos.", "respuestas": ["We love them."], "explicacion": "We love + them.", "t": "ej", "id": "n37-s02-e07"}, {"t": "teoria", "titulo": "Con preposiciones", "regla": "Después de una preposición también va el pronombre objeto: for (para), with (con), to (a). It is for him. Come with us.", "ejemplos": [{"en": "It is for you.", "es": "Es para ti."}, {"en": "It is for him.", "es": "Es para él."}, {"en": "Come with us.", "es": "Ven con nosotros."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "This is for ___. (yo)", "respuestas": ["me"], "explicacion": "Después de for → me.", "t": "ej", "id": "n37-s03-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "This is for ___. (ella)", "respuestas": ["her"], "explicacion": "Después de for → her.", "t": "ej", "id": "n37-s03-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "Come with ___. (nosotros)", "respuestas": ["us"], "explicacion": "Después de with → us.", "t": "ej", "id": "n37-s03-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es para él.", "respuestas": ["It is for him.", "It's for him."], "explicacion": "for + him.", "t": "ej", "id": "n37-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es para ellos.", "respuestas": ["It is for them.", "It's for them."], "explicacion": "for + them.", "t": "ej", "id": "n37-s03-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ven con nosotros.", "respuestas": ["Come with us."], "explicacion": "with + us.", "t": "ej", "id": "n37-s03-e06"}, {"t": "teoria", "titulo": "Sujeto u objeto", "regla": "Sujeto = quien hace la acción (I, he, they…). Objeto = quien la recibe (me, him, them…).", "ejemplos": [{"en": "I like him.", "es": "Él me gusta a mí."}, {"en": "He likes me.", "es": "A él le gusto yo."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ like coffee. (yo)", "respuestas": ["I"], "explicacion": "Sujeto → I.", "t": "ej", "id": "n37-s04-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "She likes ___. (yo)", "respuestas": ["me"], "explicacion": "Objeto → me.", "t": "ej", "id": "n37-s04-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is my friend. (él)", "respuestas": ["He"], "explicacion": "Sujeto → he.", "t": "ej", "id": "n37-s04-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "I know ___. (él)", "respuestas": ["him"], "explicacion": "Objeto → him.", "t": "ej", "id": "n37-s04-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ are here. (ellos)", "respuestas": ["They"], "explicacion": "Sujeto → they.", "t": "ej", "id": "n37-s04-e05"}, {"tipo": "escribir", "subtipo": "completar", "q": "I like ___. (ellos)", "respuestas": ["them"], "explicacion": "Objeto → them.", "t": "ej", "id": "n37-s04-e06"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: like / He / me / does not", "respuestas": ["He does not like me."], "explicacion": "Sujeto + does not + verbo + objeto.", "t": "ej", "id": "n37-s04-e07"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PRONOMBRES OBJETO. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: he", "respuestas": ["him"], "explicacion": "he → him.", "t": "ej", "id": "n37-s05-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es para ellos.", "respuestas": ["It is for them.", "It's for them."], "explicacion": "for + them.", "t": "ej", "id": "n37-s05-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: she", "respuestas": ["her"], "explicacion": "she → her.", "t": "ej", "id": "n37-s05-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "This is for ___. (yo)", "respuestas": ["me"], "explicacion": "Después de for → me.", "t": "ej", "id": "n37-s05-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ like coffee. (yo)", "respuestas": ["I"], "explicacion": "Sujeto → I.", "t": "ej", "id": "n37-s05-e05"}, {"tipo": "escribir", "subtipo": "completar", "q": "Come with ___. (nosotros)", "respuestas": ["us"], "explicacion": "Después de with → us.", "t": "ej", "id": "n37-s05-e06"}, {"tipo": "escribir", "subtipo": "completar", "q": "She likes ___. (yo)", "respuestas": ["me"], "explicacion": "yo (objeto) → me.", "t": "ej", "id": "n37-s05-e07"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ are here. (ellos)", "respuestas": ["They"], "explicacion": "Sujeto → they.", "t": "ej", "id": "n37-s05-e08"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: like / He / me / does not", "respuestas": ["He does not like me."], "explicacion": "Sujeto + does not + verbo + objeto.", "t": "ej", "id": "n37-s05-e09"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es para él.", "respuestas": ["It is for him.", "It's for him."], "explicacion": "for + him.", "t": "ej", "id": "n37-s05-e10"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella me conoce.", "respuestas": ["She knows me."], "explicacion": "She knows + me.", "t": "ej", "id": "n37-s05-e11"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Los queremos.", "respuestas": ["We love them."], "explicacion": "We love + them.", "t": "ej", "id": "n37-s05-e12"}, {"tipo": "escribir", "subtipo": "completar", "q": "I like ___. (ellos)", "respuestas": ["them"], "explicacion": "Objeto → them.", "t": "ej", "id": "n37-s05-e13"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre objeto de: we", "respuestas": ["us"], "explicacion": "we → us.", "t": "ej", "id": "n37-s05-e14"}]}
{"curso": "Inglés", "tema": "13. Artículos A / An", "leccion": [{"t": "teoria", "titulo": "A", "regla": "a = un/una. Va antes de un sonido de consonante: a book, a dog, a house. Ojo: university empieza con sonido /j/, por eso es a university.", "ejemplos": [{"en": "It is a book.", "es": "Es un libro."}, {"en": "It is a dog.", "es": "Es un perro."}, {"en": "It is a university.", "es": "Es una universidad."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ book.", "respuestas": ["a"], "explicacion": "Consonante → a.", "t": "ej", "id": "n13-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ dog.", "respuestas": ["a"], "explicacion": "Consonante → a.", "t": "ej", "id": "n13-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ house.", "respuestas": ["a"], "explicacion": "La h suena → a.", "t": "ej", "id": "n13-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ university.", "respuestas": ["a"], "explicacion": "Suena /j/ → a.", "t": "ej", "id": "n13-s01-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ car.", "respuestas": ["a"], "explicacion": "Consonante → a.", "t": "ej", "id": "n13-s01-e05"}, {"t": "teoria", "titulo": "An", "regla": "an = un/una. Va antes de un sonido de vocal: an apple, an egg, an hour (la h no suena).", "ejemplos": [{"en": "It is an apple.", "es": "Es una manzana."}, {"en": "It is an egg.", "es": "Es un huevo."}, {"en": "It is an hour.", "es": "Es una hora."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ apple.", "respuestas": ["an"], "explicacion": "Vocal → an.", "t": "ej", "id": "n13-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ egg.", "respuestas": ["an"], "explicacion": "Vocal → an.", "t": "ej", "id": "n13-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ hour.", "respuestas": ["an"], "explicacion": "La h no suena → an.", "t": "ej", "id": "n13-s02-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ orange.", "respuestas": ["an"], "explicacion": "Vocal → an.", "t": "ej", "id": "n13-s02-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ umbrella.", "respuestas": ["an"], "explicacion": "Vocal → an.", "t": "ej", "id": "n13-s02-e05"}, {"t": "teoria", "titulo": "A o AN", "regla": "Decide por el sonido, no por la letra. Con profesiones también se usa: She is a doctor.", "ejemplos": [{"en": "He is an engineer.", "es": "Él es ingeniero."}, {"en": "She is a teacher.", "es": "Ella es maestra."}, {"en": "I am a student.", "es": "Soy estudiante."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ elephant.", "respuestas": ["an"], "explicacion": "Vocal → an.", "t": "ej", "id": "n13-s03-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is ___ pen.", "respuestas": ["a"], "explicacion": "Consonante → a.", "t": "ej", "id": "n13-s03-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "He is ___ engineer.", "respuestas": ["an"], "explicacion": "Vocal → an.", "t": "ej", "id": "n13-s03-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "She is ___ artist.", "respuestas": ["an"], "explicacion": "Vocal → an.", "t": "ej", "id": "n13-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es un huevo.", "respuestas": ["It is an egg.", "It's an egg."], "explicacion": "Huevo empieza con vocal → an.", "t": "ej", "id": "n13-s03-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es un perro.", "respuestas": ["It is a dog.", "It's a dog."], "explicacion": "Perro empieza con consonante → a.", "t": "ej", "id": "n13-s03-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Soy ingeniero.", "respuestas": ["I am an engineer.", "I'm an engineer."], "explicacion": "engineer → an.", "t": "ej", "id": "n13-s03-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella es doctora.", "respuestas
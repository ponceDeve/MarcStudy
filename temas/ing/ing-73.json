{"curso": "Inglés", "tema": "73. Should / Must", "leccion": [{"t": "teoria", "titulo": "Should", "regla": "should = deberías (consejo): You should sleep. She should study. Negativo: shouldn't.", "ejemplos": [{"en": "You should sleep.", "es": "Deberías dormir."}, {"en": "You shouldn't eat a lot.", "es": "No deberías comer mucho."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Deberías dormir.", "respuestas": ["You should sleep."], "explicacion": "should + verbo base.", "t": "ej", "id": "n73-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella debería estudiar.", "respuestas": ["She should study."], "explicacion": "should sin -s.", "t": "ej", "id": "n73-s01-e02"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: You should eat.", "respuestas": ["You should not eat.", "You shouldn't eat."], "explicacion": "shouldn't.", "t": "ej", "id": "n73-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Debo trabajar?", "respuestas": ["Should I work?"], "explicacion": "Should + sujeto + verbo?", "t": "ej", "id": "n73-s01-e04"}, {"t": "teoria", "titulo": "Must", "regla": "must = obligación fuerte: You must stop. Negativo: mustn't = está prohibido.", "ejemplos": [{"en": "You must stop.", "es": "Debes parar."}, {"en": "You mustn't run here.", "es": "No debes correr aquí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Debes parar aquí.", "respuestas": ["You must stop here."], "explicacion": "must + verbo base.", "t": "ej", "id": "n73-s02-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No debes correr aquí.", "respuestas": ["You mustn't run here.", "You must not run here."], "explicacion": "mustn't = prohibido.", "t": "ej", "id": "n73-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "You ___ open the door. (prohibido)", "respuestas": ["mustn't", "must not"], "explicacion": "mustn't.",
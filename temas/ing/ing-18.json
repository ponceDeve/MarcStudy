{"curso": "Inglés", "tema": "18. Adjetivos Posesivos", "leccion": [{"t": "teoria", "titulo": "My y Your", "regla": "my = mi (de yo). your = tu / su (de you). Van antes del sustantivo: my book, your house.", "ejemplos": [{"en": "My name is Ana.", "es": "Mi nombre es Ana."}, {"en": "Your book is here.", "es": "Tu libro está aquí."}, {"en": "It is my bag.", "es": "Es mi bolsa."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ name is Ana. (de mí)", "respuestas": ["My"], "explicacion": "yo → my.", "t": "ej", "id": "n18-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ book is here. (de ti)", "respuestas": ["Your"], "explicacion": "tú → your.", "t": "ej", "id": "n18-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Mi libro.", "respuestas": ["my book"], "explicacion": "yo → my.", "t": "ej", "id": "n18-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Tu casa.", "respuestas": ["your house"], "explicacion": "tú → your.", "t": "ej", "id": "n18-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es mi bolsa.", "respuestas": ["It is my bag.", "It's my bag."], "explicacion": "yo → my.", "t": "ej", "id": "n18-s01-e05"}, {"t": "teoria", "titulo": "His, Her, Its", "regla": "his = de él. her = de ella. its = de una cosa o animal.", "ejemplos": [{"en": "His name is Tom.", "es": "Su nombre es Tom (de él)."}, {"en": "Her name is Ana.", "es": "Su nombre es Ana (de ella)."}, {"en": "Its name is Max.", "es": "Su nombre es Max (del perro)."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ book is here. (de él)", "respuestas": ["His"], "explicacion": "él → his.", "t": "ej", "id": "n18-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ bag is here. (de ella)", "respuestas": ["Her"], "explicacion": "ella → her.", "t": "ej", "id": "n18-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is a dog. ___ name is Max.", "
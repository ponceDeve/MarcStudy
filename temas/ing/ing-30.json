{"curso": "Inglés", "tema": "30. Contables E Incontables", "leccion": [{"t": "teoria", "titulo": "Contables", "regla": "Se pueden contar: a/an en singular y -s en plural. an apple → apples, a book → books.", "ejemplos": [{"en": "an apple, two apples", "es": "una manzana, dos manzanas"}, {"en": "a book, three books", "es": "un libro, tres libros"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I want ___ apple.", "respuestas": ["an"], "explicacion": "Contable singular → a/an.", "t": "ej", "id": "n30-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe el plural de: book", "respuestas": ["books"], "explicacion": "Contable → -s.", "t": "ej", "id": "n30-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe el plural de: egg", "respuestas": ["eggs"], "explicacion": "Contable → -s.", "t": "ej", "id": "n30-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "I have two ___. (book)", "respuestas": ["books"], "explicacion": "Contable plural.", "t": "ej", "id": "n30-s01-e04"}, {"t": "teoria", "titulo": "Incontables", "regla": "No se cuentan: no llevan a/an ni plural: water, bread, rice, money, coffee, milk.", "ejemplos": [{"en": "I want water.", "es": "Quiero agua."}, {"en": "Money is important.", "es": "El dinero es importante."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? water", "respuestas": ["incontable", "uncountable"], "explicacion": "water no se cuenta.", "t": "ej", "id": "n30-s02-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? apple", "respuestas": ["contable", "countable"], "explicacion": "apple sí se cuenta.", "t": "ej", "id": "n30-s02-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? rice", "respuestas": ["incontable", "uncountable"], "explicacion": "rice no se cuenta.", "t": "ej", "id": "n30-s02-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? egg", "respuestas": ["contable", "countable"], "explicacion": "egg sí se cuenta.", "t": "ej", "id": "n30-s02-e04"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? money", "respuestas": ["incontable", "uncountable"], "explicacion": "money no se cuenta.", "t": "ej", "id": "n30-s02-e05"}, {"t": "teoria", "titulo": "Is o are", "regla": "Incontable → is. Contable plural → are: Water is good. Apples are good.", "ejemplos": [{"en": "Water is good.", "es": "El agua es buena."}, {"en": "Apples are good.", "es": "Las manzanas son buenas."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "Water ___ good.", "respuestas": ["is"], "explicacion": "Incontable → is.", "t": "ej", "id": "n30-s03-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "Apples ___ good.", "respuestas": ["are"], "explicacion": "Plural → are.", "t": "ej", "id": "n30-s03-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "Bread ___ here.", "respuestas": ["is"], "explicacion": "Incontable → is.", "t": "ej", "id": "n30-s03-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "Eggs ___ here.", "respuestas": ["are"], "explicacion": "Plural → are.", "t": "ej", "id": "n30-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: El café está caliente.", "respuestas": ["The coffee is hot."], "explicacion": "Incontable → is.", "t": "ej", "id": "n30-s03-e05"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en CONTABLES E INCONTABLES. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? rice", "respuestas": ["incontable", "uncountable"], "explicacion": "rice no se cuenta.", "t": "ej", "id": "n30-s04-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "I want ___ apple.", "respuestas": ["an"], "explicacion": "Contable singular → a/an.", "t": "ej", "id": "n30-s04-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "Apples ___ good.", "respuestas": ["are"], "explicacion": "Plural → are.", "t": "ej", "id": "n30-s04-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: El café está caliente.", "respuestas": ["The coffee is hot."], "explicacion": "Incontable → is.", "t": "ej", "id": "n30-s04-e04"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe el plural de: egg", "respuestas": ["eggs"], "explicacion": "Contable → -s.", "t": "ej", "id": "n30-s04-e05"}, {"tipo": "escribir", "subtipo": "completar", "q": "Eggs ___ here.", "respuestas": ["are"], "explicacion": "Plural → are.", "t": "ej", "id": "n30-s04-e06"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? water", "respuestas": ["incontable", "uncountable"], "explicacion": "water no se cuenta.", "t": "ej", "id": "n30-s04-e07"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe el plural de: book", "respuestas": ["books"], "explicacion": "Contable → -s.", "t": "ej", "id": "n30-s04-e08"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? money", "respuestas": ["incontable", "uncountable"], "explicacion": "money no se cuenta.", "t": "ej", "id": "n30-s04-e09"}, {"tipo": "escribir", "subtipo": "completar", "q": "Bread ___ here.", "respuestas": ["is"], "explicacion": "Incontable → is.", "t": "ej", "id": "n30-s04-e10"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? apple", "respuestas": ["contable", "countable"], "explicacion": "apple sí se cuenta.", "t": "ej", "id": "n30-s04-e11"}, {"tipo": "escribir", "subtipo": "completar", "q": "Water ___ good.", "respuestas": ["is"], "explicacion": "Incontable → is.", "t": "ej", "id": "n30-s04-e12"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Contable o incontable? egg", "respuestas": ["contable", "countable"], "explicacion": "egg sí se cuenta.", "t": "ej", "id": "n30-s04-e13"}, {"tipo": "escribir", "subtipo": "completar", "q": "I have two ___. (book)", "respuestas": ["books"], "explicacion": "Contable plural.", "t": "ej", "id": "n30-s04-e14"}]}
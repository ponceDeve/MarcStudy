{"curso": "Inglés", "tema": "82. Pasado De To Be", "leccion": [{"t": "teoria", "titulo": "Was y were", "regla": "Pasado de to be: I/he/she/it → was. you/we/they → were. I was tired. They were here.", "ejemplos": [{"en": "I was tired.", "es": "Estaba cansado."}, {"en": "She was at home.", "es": "Ella estaba en casa."}, {"en": "They were here.", "es": "Ellos estaban aquí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ tired.", "respuestas": ["was"], "explicacion": "I → was.", "t": "ej", "id": "n82-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "They ___ here.", "respuestas": ["were"], "explicacion": "they → were.", "t": "ej", "id": "n82-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ at home.", "respuestas": ["was"], "explicacion": "she → was.", "t": "ej", "id": "n82-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "We ___ happy.", "respuestas": ["were"], "explicacion": "we → were.", "t": "ej", "id": "n82-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Estaba cansado.", "respuestas": ["I was tired."], "explicacion": "I → was.", "t": "ej", "id": "n82-s01-e05"}, {"t": "teoria", "titulo": "Negativo", "regla": "was not = wasn't, were not = weren't.", "ejemplos": [{"en": "I wasn't tired.", "es": "No estaba cansado."}, {"en": "They weren't here.", "es": "Ellos no estaban aquí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: She was at home.", "respuestas": ["She was not at home.", "She wasn't at home."], "explicacion": "wasn't.", "t": "ej", "id": "n82-s02-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: They were here.", "respuestas": ["They were not here.", "They weren't here."], "explicacion": "weren't.", "t": "ej", "id": "n82-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No estábamos cansados.", "respuestas": ["We weren't tired.", "We were not tired."], "explicacion": "we → weren't.", "t": "ej", "id": "n82-s02-e03"}, {"t": "teoria", "titulo": "Preguntas", "regla": "Pregunta: Was/Were + sujeto? Were you at home? Yes, I was. Where were you?", "ejemplos": [{"en": "Were you at home?", "es": "¿Estabas en casa?"}, {"en": "Where were you?", "es": "¿Dónde estabas?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You were at home.", "respuestas": ["Were you at home?"], "explicacion": "Were + you.", "t": "ej", "id": "n82-s03-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: She was tired.", "respuestas": ["Was she tired?"], "explicacion": "Was + she.", "t": "ej", "id": "n82-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Dónde estabas?", "respuestas": ["Where were you?"], "explicacion": "Where + were + you.", "t": "ej", "id": "n82-s03-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Were you at home?", "respuestas": ["Yes, I was."], "explicacion": "Yes, I was.", "t": "ej", "id": "n82-s03-e04"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Was he tired?", "respuestas": ["No, he wasn't.", "No, he was not."], "explicacion": "No, he wasn't.", "t": "ej", "id": "n82-s03-e05"}, {"t": "teoria", "titulo": "Tiempo pasado", "regla": "yesterday = ayer · last night = anoche · last week = la semana pasada.", "ejemplos": [{"en": "I was at home yesterday.", "es": "Ayer estaba en casa."}, {"en": "They were here last night.", "es": "Anoche estaban aquí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ayer estaba en casa.", "respuestas": ["I was at home yesterday."], "explicacion": "yesterday.", "t": "ej", "id": "n82-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Anoche estábamos cansados.", "respuestas": ["We were tired last night."], "explicacion": "last night.", "t": "ej", "id": "n82-s04-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella estaba aquí la semana pasada.", "respuestas": ["She was here last week."], "explicacion": "last week.", "t": "ej", "id": "n82-s04-e03"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PASADO DE TO BE. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: She was tired.", "respuestas": ["Was she tired?"], "explicacion": "Was + she.", "t": "ej", "id": "n82-s05-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella estaba aquí la semana pasada.", "respuestas": ["She was here last week."], "explicacion": "last week.", "t": "ej", "id": "n82-s05-e02"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You were at home.", "respuestas": ["Were you at home?"], "explicacion": "Were + you.", "t": "ej", "id": "n82-s05-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "They ___ here.", "respuestas": ["were"], "explicacion": "they → were.", "t": "ej", "id": "n82-s05-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Estaba cansado.", "respuestas": ["I was tired."], "explicacion": "I → was.", "t": "ej", "id": "n82-s05-e05"}, {"tipo": "escribir", "subtipo": "completar", "q": "We ___ happy.", "respuestas": ["were"], "explicacion": "we → were.", "t": "ej", "id": "n82-s05-e06"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: They were here.", "respuestas": ["They were not here.", "They weren't here."], "explicacion": "weren't.", "t": "ej", "id": "n82-s05-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No estábamos cansados.", "respuestas": ["We weren't tired.", "We were not tired."], "explicacion": "we → weren't.", "t": "ej", "id": "n82-s05-e08"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Anoche estábamos cansados.", "respuestas": ["We were tired last night."], "explicacion": "last night.", "t": "ej", "id": "n82-s05-e09"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: She was at home.", "respuestas": ["She was not at home.", "She wasn't at home."], "explicacion": "wasn't.", "t": "ej", "id": "n82-s05-e10"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Dónde estabas?", "respuestas": ["Where were you?"], "explicacion": "Where + were + you.", "t": "ej", "id": "n82-s05-e11"}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ tired.", "respuestas": ["was"], "explicacion": "I → was.", "t": "ej", "id": "n82-s05-e12"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Was he tired?", "respuestas": ["No, he wasn't.", "No, he was not."], "explicacion": "No, he wasn't.", "t": "ej", "id": "n82-s05-e13"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ayer estaba en casa.", "respuestas": ["I was at home yesterday."], "explicacion": "yesterday.", "t": "ej", "id": "n82-s05-e14"}]}
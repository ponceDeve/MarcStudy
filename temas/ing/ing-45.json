{"curso": "Inglés", "tema": "45. Palabras De Pregunta", "leccion": [{"t": "teoria", "titulo": "When y What time", "regla": "When = cuándo. What time = a qué hora. When is the class? What time is it?", "ejemplos": [{"en": "When is the class?", "es": "¿Cuándo es la clase?"}, {"en": "What time is it?", "es": "¿Qué hora es?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuándo es la clase?", "respuestas": ["When is the class?"], "explicacion": "When + is + sujeto.", "t": "ej", "id": "n45-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Qué hora es?", "respuestas": ["What time is it?"], "explicacion": "What time + is + it.", "t": "ej", "id": "n45-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is the test? (cuándo)", "respuestas": ["When"], "explicacion": "cuándo = when.", "t": "ej", "id": "n45-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ time is it?", "respuestas": ["What"], "explicacion": "What time.", "t": "ej", "id": "n45-s01-e04"}, {"t": "teoria", "titulo": "Why y Because", "regla": "Why = por qué. Se responde con because = porque: Why are you tired? Because I work.", "ejemplos": [{"en": "Why are you tired?", "es": "¿Por qué estás cansado?"}, {"en": "Because I work.", "es": "Porque trabajo."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Por qué estás cansado?", "respuestas": ["Why are you tired?"], "explicacion": "Why + are + you.", "t": "ej", "id": "n45-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ are you here? (por qué)", "respuestas": ["Why"], "explicacion": "por qué = why.", "t": "ej", "id": "n45-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "I am tired ___ I work. (porque)", "respuestas": ["because"], "explicacion": "porque = because.", "t": "ej", "id": "n45-s02-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Porque trabajo aquí.", "respuestas": ["Because I work here."], "explicacion": "Because + frase.", "t": "ej", "id": "n45-s02-e04"}, {"t": "teoria", "titulo": "Which", "regla": "Which = cuál (entre opciones): Which book is yours? Which one?", "ejemplos": [{"en": "Which book is yours?", "es": "¿Cuál libro es tuyo?"}, {"en": "Which is your bag?", "es": "¿Cuál es tu bolsa?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ book is yours? (cuál)", "respuestas": ["Which"], "explicacion": "cuál (opciones) = which.", "t": "ej", "id": "n45-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuál es tu bolsa?", "respuestas": ["Which is your bag?"], "explicacion": "Which + is + sujeto.", "t": "ej", "id": "n45-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuál coche es rápido?", "respuestas": ["Which car is fast?"], "explicacion": "Which + sustantivo.", "t": "ej", "id": "n45-s03-e03"}, {"t": "teoria", "titulo": "How much / How many", "regla": "How much + incontable: How much water? How many + plural contable: How many books?", "ejemplos": [{"en": "How much is it?", "es": "¿Cuánto cuesta?"}, {"en": "How many books?", "es": "¿Cuántos libros?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "How ___ water do you want?", "respuestas": ["much"], "explicacion": "Incontable → much.", "t": "ej", "id": "n45-s04-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "How ___ books do you have?", "respuestas": ["many"], "explicacion": "Plural contable → many.", "t": "ej", "id": "n45-s04-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuánto cuesta?", "respuestas": ["How much is it?"], "explicacion": "How much + is + it.", "t": "ej", "id": "n45-s04-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuántos libros tienes?", "respuestas": ["How many books do you have?"], "explicacion": "How many + plural + do you have?", "t": "ej", "id": "n45-s04-e04"}, {"t": "teoria", "t
{"curso": "Inglés", "tema": "17. This / That / These / Those", "leccion": [{"t": "teoria", "titulo": "This y That", "regla": "this = esto/este (cerca). that = eso/aquello (lejos). This is a book. That is a bus. (That is = That's)", "ejemplos": [{"en": "This is a book.", "es": "Esto es un libro."}, {"en": "That is a bus.", "es": "Eso es un autobús."}, {"en": "That is a car.", "es": "Eso es un coche."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is a pen. (cerca)", "respuestas": ["This"], "explicacion": "Cerca → this.", "t": "ej", "id": "n17-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is a house. (lejos)", "respuestas": ["That"], "explicacion": "Lejos → that.", "t": "ej", "id": "n17-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Esto es un libro.", "respuestas": ["This is a book."], "explicacion": "Cerca → this.", "t": "ej", "id": "n17-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Eso es un coche.", "respuestas": ["That is a car.", "That's a car."], "explicacion": "Lejos → that.", "t": "ej", "id": "n17-s01-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "Is ___ a dog? (lejos)", "respuestas": ["that"], "explicacion": "Lejos → that.", "t": "ej", "id": "n17-s01-e05"}, {"t": "teoria", "titulo": "These y Those", "regla": "these = estos (cerca), those = esos (lejos). Se usan con plural: These are books. Those are cars.", "ejemplos": [{"en": "These are books.", "es": "Estos son libros."}, {"en": "Those are cars.", "es": "Esos son coches."}, {"en": "Those are buses.", "es": "Esos son autobuses."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ are books. (cerca)", "respuestas": ["These"], "explicacion": "Cerca + plural → these.", "t": "ej", "id": "n17-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ are dogs. (lejos)", "respuestas": ["Those"], "explicacion": "Lejos + plural → those.", "t": "ej", "id": "n17-s02-e02
{"curso": "Inglés", "tema": "66. Presente Simple Vs Continuo", "leccion": [{"t": "teoria", "titulo": "Hábito o ahora", "regla": "Presente simple = hábitos y hechos (I work here). Presente continuo = ahora mismo (I am working now).", "ejemplos": [{"en": "I work every day.", "es": "Trabajo todos los días."}, {"en": "I am working now.", "es": "Estoy trabajando ahora."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ every day. (work, hábito)", "respuestas": ["work"], "explicacion": "Hábito → presente simple.", "t": "ej", "id": "n66-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ now. (work, ahora)", "respuestas": ["am working"], "explicacion": "Ahora → presente continuo.", "t": "ej", "id": "n66-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ TV every night. (watch)", "respuestas": ["watches"], "explicacion": "Hábito → watches.", "t": "ej", "id": "n66-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ TV now. (watch)", "respuestas": ["is watching"], "explicacion": "Ahora → is watching.", "t": "ej", "id": "n66-s01-e04"}, {"t": "teoria", "titulo": "Palabras clave", "regla": "Simple: always, every day, usually, never. Continuo: now, right now, at the moment.", "ejemplos": [{"en": "She always eats rice.", "es": "Ella siempre come arroz."}, {"en": "She is eating rice now.", "es": "Ella está comiendo arroz ahora."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella siempre come arroz.", "respuestas": ["She always eats rice."], "explicacion": "always → simple.", "t": "ej", "id": "n66-s02-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella está comiendo arroz ahora.", "respuestas": ["She is eating rice now.", "She's eating rice now."], "explicacion": "now → continuo.", "t": "ej", "id": "n66-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos trabajan aquí.", "respuestas": ["They work here."], "explicacion": "hecho → simple.", "t": "ej", "id": "n66-s02-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos están trabajando ahora.", "respuestas": ["They are working now.", "They're working now."], "explicacion": "now → continuo.", "t": "ej", "id": "n66-s02-e04"}, {"t": "teoria", "titulo": "Verbos de estado", "regla": "Con like, want, know, love casi nunca se usa el continuo: I like coffee (no «I am liking»).", "ejemplos": [{"en": "I want water.", "es": "Quiero agua."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Quiero agua ahora.", "respuestas": ["I want water now."], "explicacion": "want no se usa en continuo.", "t": "ej", "id": "n66-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Me gusta el café.", "respuestas": ["I like coffee."], "explicacion": "like: presente simple.", "t": "ej", "id": "n66-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella conoce a Tom.", "respuestas": ["She knows Tom."], "explicacion": "know: presente simple.", "t": "ej", "id": "n66-s03-e03"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PRESENTE SIMPLE VS CONTINUO. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Me gusta el café.", "respuestas": ["I like coffee."], "explicacion": "like: presente simple.", "t": "ej", "id": "n66-s04-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ now. (work, ahora)", "respuestas": ["am working"], "explicacion": "Ahora → presente continuo.", "t": "ej", "id": "n66-s04-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos trabajan aquí.", "respuestas": ["They work here."], "explicacion": "hecho → simple.", "t": "ej", "id": "n66-s04-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ TV every night. (watch)", "respuestas": ["watches"], "explicacion": "Hábito → watches.", "t": "ej", "id": "n66-s04-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ every day. (work, hábito)", "respuestas": ["work"], "explicacion": "Hábito → presente simple.", "t": "ej", "id": "n66-s04-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Quiero agua ahora.", "respuestas": ["I want water now."], "explicacion": "want no se usa en continuo.", "t": "ej", "id": "n66-s04-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella está comiendo arroz ahora.", "respuestas": ["She is eating rice now.", "She's eating rice now."], "explicacion": "now → continuo.", "t": "ej", "id": "n66-s04-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos están trabajando ahora.", "respuestas": ["They are working now.", "They're working now."], "explicacion": "now → continuo.", "t": "ej", "id": "n66-s04-e08"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ TV now. (watch)", "respuestas": ["is watching"], "explicacion": "Ahora → is watching.", "t": "ej", "id": "n66-s04-e09"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella conoce a Tom.", "respuestas": ["She knows Tom."], "explicacion": "know: presente simple.", "t": "ej", "id": "n66-s04-e10"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella siempre come arroz.", "respuestas": ["She always eats rice."], "explicacion": "always → simple.", "t": "ej", "id": "n66-s04-e11"}]}
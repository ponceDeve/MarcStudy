{"curso": "Inglés", "tema": "19. Posesivo 'S", "leccion": [{"t": "teoria", "titulo": "Nombre + 's", "regla": "Para decir «de alguien»: dueño + 's + cosa. Ana's book = el libro de Ana.", "ejemplos": [{"en": "Ana's book", "es": "el libro de Ana"}, {"en": "Tom's house", "es": "la casa de Tom"}, {"en": "It is Ana's bag.", "es": "Es la bolsa de Ana."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: El libro de Ana.", "respuestas": ["Ana's book"], "explicacion": "dueño + 's + cosa.", "t": "ej", "id": "n19-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: La casa de Tom.", "respuestas": ["Tom's house"], "explicacion": "dueño + 's + cosa.", "t": "ej", "id": "n19-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Es la bolsa de Ana.", "respuestas": ["It is Ana's bag.", "It's Ana's bag."], "explicacion": "dueño + 's + cosa.", "t": "ej", "id": "n19-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "The pen of Tom → ___ pen.", "respuestas": ["Tom's"], "explicacion": "dueño + 's.", "t": "ej", "id": "n19-s01-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "The car of Ana → ___ car.", "respuestas": ["Ana's"], "explicacion": "dueño + 's.", "t": "ej", "id": "n19-s01-e05"}, {"t": "teoria", "titulo": "'s = is o posesión", "regla": "'s puede ser is (Tom's a doctor = Tom is a doctor) o posesión (Tom's book = el libro de Tom). Mira si después viene un sustantivo o un adjetivo/profesión.", "ejemplos": [{"en": "Tom's a doctor.", "es": "Tom es doctor. ('s = is)"}, {"en": "Tom's book is here.", "es": "El libro de Tom está aquí. ('s = posesión)"}, {"en": "Ana's tired.", "es": "Ana está cansada. ('s = is)"}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe «is» o «posesión»: Ana's tired.", "respuestas": ["is"], "explicacion": "'s + adjetivo = is.", "t": "ej", "id": "n19-s02-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe «is» o «posesión»: Ana's bag is here.", "respuestas": ["posesión", "posesion", "possession"], "explicacion": "'s + sustantivo = posesión.", "t": "ej", "id": "n19-s02-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe «is» o «posesión»: Tom's a teacher.", "respuestas": ["is"], "explicacion": "'s + profesión = is.", "t": "ej", "id": "n19-s02-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe «is» o «posesión»: Tom's house is here.", "respuestas": ["posesión", "posesion", "possession"], "explicacion": "'s + sustantivo = posesión.", "t": "ej", "id": "n19-s02-e04"}, {"t": "teoria", "titulo": "Oraciones completas", "regla": "Practica con nombre + 's en oraciones completas.", "ejemplos": [{"en": "Ana's pen is here.", "es": "El bolígrafo de Ana está aquí."}, {"en": "Tom's name is Tom.", "es": "El nombre de Tom es Tom."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: El bolígrafo de Ana está aquí.", "respuestas": ["Ana's pen is here."], "explicacion": "Ana's + sustantivo + is.", "t": "ej", "id": "n19-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: La casa de Tom está aquí.", "respuestas": ["Tom's house is here."], "explicacion": "Tom's + sustantivo + is.", "t": "ej", "id": "n19-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Dónde está la bolsa de Ana?", "respuestas": ["Where is Ana's bag?"], "explicacion": "Where is + Ana's + sustantivo.", "t": "ej", "id": "n19-s03-e03"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: Ana's / is / book / here", "respuestas": ["Ana's book is here."], "explicacion": "Dueño + sustantivo + is + lugar.", "t": "ej", "id": "n19-s03-e04"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en POSESIVO 'S. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe «is» o 
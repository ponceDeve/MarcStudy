{"curso": "Inglés", "tema": "53. There Is / There Are", "leccion": [{"t": "teoria", "titulo": "There is / There are", "regla": "There is + singular. There are + plural. There is a bed. There are two chairs.", "ejemplos": [{"en": "There is a bed.", "es": "Hay una cama."}, {"en": "There are two chairs.", "es": "Hay dos sillas."}, {"en": "There is a lamp on the table.", "es": "Hay una lámpara sobre la mesa."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "There ___ a bed.", "respuestas": ["is"], "explicacion": "Singular → is.", "t": "ej", "id": "n53-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "There ___ two chairs.", "respuestas": ["are"], "explicacion": "Plural → are.", "t": "ej", "id": "n53-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay una lámpara.", "respuestas": ["There is a lamp.", "There's a lamp."], "explicacion": "There is + singular.", "t": "ej", "id": "n53-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay tres libros.", "respuestas": ["There are three books."], "explicacion": "There are + plural.", "t": "ej", "id": "n53-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay un banco aquí.", "respuestas": ["There is a bank here.", "There's a bank here."], "explicacion": "There is + a + sustantivo.", "t": "ej", "id": "n53-s01-e05"}, {"t": "teoria", "titulo": "Negativo", "regla": "There isn't / There aren't. Con plural o incontable suele usarse any: There aren't any chairs.", "ejemplos": [{"en": "There isn't a bed.", "es": "No hay una cama."}, {"en": "There aren't any chairs.", "es": "No hay sillas."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: There is a bed.", "respuestas": ["There is not a bed.", "There isn't a bed."], "explicacion": "There isn't.", "t": "ej", "id": "n53-s02-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: There are chairs.", "respuestas": ["There are not any chairs.", "There aren't any chairs."], "explicacion": "There aren't any.", "t": "ej", "id": "n53-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No hay agua.", "respuestas": ["There isn't any water.", "There is not any water."], "explicacion": "incontable → isn't any.", "t": "ej", "id": "n53-s02-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "There ___ any books.", "respuestas": ["aren't"], "explicacion": "plural negativo → aren't.", "t": "ej", "id": "n53-s02-e04"}, {"t": "teoria", "titulo": "Preguntas", "regla": "Is there...? / Are there...? Respuesta: Yes, there is. / No, there isn't.", "ejemplos": [{"en": "Is there a bank?", "es": "¿Hay un banco?"}, {"en": "Are there any chairs?", "es": "¿Hay sillas?"}, {"en": "Yes, there are.", "es": "Sí, hay."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: There is a bank.", "respuestas": ["Is there a bank?"], "explicacion": "Is there + a + sustantivo.", "t": "ej", "id": "n53-s03-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: There are chairs.", "respuestas": ["Are there any chairs?", "Are there chairs?"], "explicacion": "Are there + plural.", "t": "ej", "id": "n53-s03-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Is there a bank?", "respuestas": ["Yes, there is."], "explicacion": "Yes, there is.", "t": "ej", "id": "n53-s03-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Are there any chairs?", "respuestas": ["No, there aren't.", "No, there are not."], "explicacion": "No, there aren't.", "t": "ej", "id": "n53-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Hay agua?", "respuestas": ["Is there any water?"], "explicacion": "Is there + any + incontable.", "t": "ej", "id": "n53-s03-e05"}, {"t": "teoria", "titulo": "Con lugares", "regla": "Combina con las preposiciones: There is a book on the table.", "ejemplos": [{"en": "There is a cat under the chair.", "es": "Hay un gato debajo de la silla."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay un gato debajo de la silla.", "respuestas": ["There is a cat under the chair.", "There's a cat under the chair."], "explicacion": "There is + sustantivo + lugar.", "t": "ej", "id": "n53-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay dos libros sobre la mesa.", "respuestas": ["There are two books on the table."], "explicacion": "There are + plural + lugar.", "t": "ej", "id": "n53-s04-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay un parque al lado del banco.", "respuestas": ["There is a park next to the bank.", "There's a park next to the bank."], "explicacion": "There is + sustantivo + lugar.", "t": "ej", "id": "n53-s04-e03"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en THERE IS / THERE ARE. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: There is a bank.", "respuestas": ["Is there a bank?"], "explicacion": "Is there + a + sustantivo.", "t": "ej", "id": "n53-s05-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Hay agua?", "respuestas": ["Is there any water?"], "explicacion": "Is there + any + incontable.", "t": "ej", "id": "n53-s05-e02"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: There are chairs.", "respuestas": ["There are not any chairs.", "There aren't any chairs."], "explicacion": "There aren't any.", "t": "ej", "id": "n53-s05-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay un parque al lado del banco.", "respuestas": ["There is a park next to the bank.", "There's a park next to the bank."], "explicacion": "There is + sustantivo + lugar.", "t": "ej", "id": "n53-s05-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "There ___ two chairs.", "respuestas": ["are"], "explicacion": "Plural → are.", "t": "ej", "id": "n53-s05-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay tres libros.", "respuestas": ["There are three books."], "explicacion": "There are + plural.", "t": "ej", "id": "n53-s05-e06"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: There is a bed.", "respuestas": ["There is not a bed.", "There isn't a bed."], "explicacion": "There isn't.", "t": "ej", "id": "n53-s05-e07"}, {"tipo": "escribir", "subtipo": "completar", "q": "There ___ a bed.", "respuestas": ["is"], "explicacion": "Singular → is.", "t": "ej", "id": "n53-s05-e08"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Is there a bank?", "respuestas": ["Yes, there is."], "explicacion": "Yes, there is.", "t": "ej", "id": "n53-s05-e09"}, {"tipo": "escribir", "subtipo": "completar", "q": "There ___ any books.", "respuestas": ["aren't"], "explicacion": "plural negativo → aren't.", "t": "ej", "id": "n53-s05-e10"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay un gato debajo de la silla.", "respuestas": ["There is a cat under the chair.", "There's a cat under the chair."], "explicacion": "There is + sustantivo + lugar.", "t": "ej", "id": "n53-s05-e11"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay un banco aquí.", "respuestas": ["There is a bank here.", "There's a bank here."], "explicacion": "There is + a + sustantivo.", "t": "ej", "id": "n53-s05-e12"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No hay agua.", "respuestas": ["There isn't any water.", "There is not any water."], "explicacion": "incontable → isn't any.", "t": "ej", "id": "n53-s05-e13"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Hay dos libros sobre la mesa.", "respuestas": ["There are two books on the table."], "explicacion": "There are + plural + lugar.", "t": "ej", "id": "n53-s05-e14"}]}
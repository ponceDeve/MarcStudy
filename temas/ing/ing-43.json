{"curso": "Inglés", "tema": "43. Adverbios De Frecuencia", "leccion": [{"t": "teoria", "titulo": "Las palabras", "regla": "always = siempre · usually = normalmente · often = a menudo · sometimes = a veces · never = nunca.", "ejemplos": [{"en": "I always drink water.", "es": "Siempre bebo agua."}, {"en": "She sometimes eats rice.", "es": "A veces ella come arroz."}, {"en": "They never work here.", "es": "Nunca trabajan aquí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe en inglés: siempre", "respuestas": ["always"], "explicacion": "always = siempre.", "t": "ej", "id": "n43-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe en inglés: nunca", "respuestas": ["never"], "explicacion": "never = nunca.", "t": "ej", "id": "n43-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe en inglés: a veces", "respuestas": ["sometimes"], "explicacion": "sometimes = a veces.", "t": "ej", "id": "n43-s01-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe en inglés: normalmente", "respuestas": ["usually"], "explicacion": "usually = normalmente.", "t": "ej", "id": "n43-s01-e04"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe en inglés: a menudo", "respuestas": ["often"], "explicacion": "often = a menudo.", "t": "ej", "id": "n43-s01-e05"}, {"t": "teoria", "titulo": "Posición", "regla": "El adverbio va antes del verbo: I always eat bread. Con to be va después: She is always here.", "ejemplos": [{"en": "I always eat bread.", "es": "Siempre como pan."}, {"en": "She is always here.", "es": "Ella siempre está aquí."}, {"en": "He never works here.", "es": "Él nunca trabaja aquí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: always / I / drink / water", "respuestas": ["I always drink water."], "explicacion": "Sujeto + adverbio + verbo.", "t": "ej", "id": "n43-s02-e01"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: never / She / eats / rice", "respuestas": ["She never eats rice."], "explicacion": "Sujeto + adverbio + verbo.", "t": "ej", "id": "n43-s02-e02"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: is / He / always / here", "respuestas": ["He is always here."], "explicacion": "Con to be: verbo + adverbio.", "t": "ej", "id": "n43-s02-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Siempre bebo agua.", "respuestas": ["I always drink water."], "explicacion": "Sujeto + adverbio + verbo.", "t": "ej", "id": "n43-s02-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella nunca come arroz.", "respuestas": ["She never eats rice."], "explicacion": "Sujeto + adverbio + verbo (he/she + s).", "t": "ej", "id": "n43-s02-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos siempre están aquí.", "respuestas": ["They are always here.", "They're always here."], "explicacion": "to be + adverbio.", "t": "ej", "id": "n43-s02-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: A veces trabajo aquí.", "respuestas": ["I sometimes work here."], "explicacion": "Sujeto + adverbio + verbo.", "t": "ej", "id": "n43-s02-e07"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en ADVERBIOS DE FRECUENCIA. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena y escribe la oración: never / She / eats / rice", "respuestas": ["She never eats rice."], "explicacion": "Sujeto + adverbio + verbo.", "t": "ej", "id": "n43-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos siempre están aquí.", "respuestas": ["They are always here.", "They're always here."], "explicacion": "to be + adverbio.", "t": "ej", "id": "n43-s03-e02"}, {"tipo": "escribir", "subtipo": "ordenar_escribir", "q": "Ordena 
      "orden": 1,
      "titulo": "I, you, we",
      "teoria": "En inglés **siempre** se dice el sujeto: I am Max (no «Am Max»). **I** siempre va con mayúscula. **you** = tú, usted o ustedes. **we** = nosotros.",
      "ejemplos": [
        {
          "en": "I am Max.",
          "es": "Yo soy Max."
        },
        {
          "en": "You are Ana.",
          "es": "Tú eres Ana."
        },
        {
          "en": "We are Ana and Max.",
          "es": "Nosotros somos Ana y Max."
        }
      ],

{
  "curso": "Biología",
  "tema": "Herencia restringida al sexo",
  "glosario": {
    "Holándrico": "Relativo a los rasgos genéticos transmitidos exclusivamente a través del cromosoma Y."
  },
  "theory": [
    {
      "titulo": "Genes Holándricos",
      "puntos": [
        {
          "texto": "Genes holándricos ∈ Y",
          "explicacion": "Son secuencias genéticas propias de la región diferencial del cromosoma Y, manifestando la herencia restringida exclusivamente a varones."
        },
        {
          "texto": "Hipertricosis auricular",
          "explicacion": "Enfermedad ligada al cromosoma Y que causa el crecimiento excesivo de vello en los pabellones auditivos de los varones."
        },
        {
          "texto": "Región SRY",
          "explicacion": "El gen Sex-determining Region Y (SRY) desencadena el desarrollo testicular. Su alteración genera síndromes del desarrollo sexual."
        },
        {
          "texto": "Síndrome del SRY",
          "explicacion": "Mutación en el gen SRY que causa disgenesia gonadal, donde el desarrollo embrionario masculino se ve gravemente afectado."
        },
        {
          "texto": "Síndrome de Sertoli",
          "explicacion": "Condición genética heredada por el cromosoma Y que resulta en la infertilidad debido a la ausencia de espermatozoides funcionales."
        }
      ]
    },

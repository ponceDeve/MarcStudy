        {
          "texto": "Herencia del sexo",
          "explicacion": "Es el estudio respecto a los genes que se encuentran ubicados en el par cromosómico sexual específico de una especie."
        },
        {
          "texto": "Especie modelo ✓ moscas",
          "explicacion": "La Drosophila melanogaster, conocida como mosca de la fruta, es la especie modelo ampliamente usada en genética."
        },
        {
          "texto": "Par sexual en Drosophila",
          "explicacion": "En las moscas de la fruta, el par cromosómico 4 es el par sexual determinante."
        },
        {
          "texto": "Par sexual humano",
          "explicacion": "En los humanos, el par cromosómico 23 es el responsable de definir el sexo genético del individuo (XX en mujeres, XY en varones)."
        }
      ]

{
  "curso": "Biología",
  "tema": "Plantas medicinales",
  "glosario": {
    "Antitusígeno": "Sustancia natural que reduce la tos.[cite: 2]",
    "Antiinflamatorio": "Agente natural que reduce la inflamación tisular.[cite: 2]",
    "Antilitolítica": "Sustancia que previene o disuelve cálculos renales.[cite: 2]"
  },
  "theory": [
    {
      "titulo": "Importancia Medicinal",
      "puntos": [
        {
          "texto": "Plantas medicinales → curar enfermedades.[cite: 2]",
          "explicacion": "Producen compuestos que ayudan a curar enfermedades mediante principios activos biológicos.[cite: 2] Son sustancias con potentes efectos terapéuticos capaces de erradicar patógenos.[cite: 2]"
        },
        {
          "texto": "Eucalipto = antitusígeno.[cite: 2]",
          "explicacion": "El eucalipto se define como un potente antitusígeno botánico.[cite: 2] Actúa sobre el sistema nervioso respiratorio para reducir o suprimir el reflejo de la tos.[cite: 2]"
        },
        {
          "texto": "Llantén = antiinflamatorio.[cite: 2]",
          "explicacion": "El llantén se define como un agente antiinflamatorio.[cite: 2] Tiene capacidad para reducir significativamente la inflamación superficial, el enrojecimiento y el dolor tisular.[cite: 2]"
        },
        {
          "texto": "Chanca piedra = antilitolítica.[cite: 2]",
          "explicacion": "La chanca piedra tiene acción antilitolítica en el sistema renal.[cite: 2] Sus compuestos químicos contribuyen a fragmentar y prevenir la formación de cálculos en vías urinarias.[cite: 2]"
        }
      ]
    },

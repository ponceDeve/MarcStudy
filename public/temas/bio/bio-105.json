{
  "curso": "Biología",
  "tema": "Plantas alimenticias",
  "glosario": {},
  "theory": [
    {
      "titulo": "Importancia Nutricional",
      "puntos": [
        {
          "texto": "Alimentos diarios ⊃ derivados vegetales.[cite: 2]",
          "explicacion": "Los alimentos diarios contienen un 80% de derivados de plantas.[cite: 2] La nutrición humana depende casi enteramente de la producción botánica.[cite: 2]"
        },
        {
          "texto": "Derivado vegetal ⊃ azúcares.[cite: 2]",
          "explicacion": "Contiene abundantes azúcares en su estructura.[cite: 2] Son carbohidratos simples de rápida absorción que proporcionan energía inmediata al metabolismo humano.[cite: 2]"
        },
        {
          "texto": "Derivado vegetal ⊃ carbohidrato tipo almidón.[cite: 2]",
          "explicacion": "Contiene carbohidrato del tipo almidón.[cite: 2] El almidón es un polisacárido de reserva energética abundante en cereales y principal fuente de calorías complejas.[cite: 2]"
        },
        {
          "texto": "Derivado vegetal ⊃ fibra tipo celulosa.[cite: 2]",
          "explicacion": "Contiene fibra del tipo celulosa.[cite: 2] Actúa como fibra dietética que estimula el tránsito intestinal y promueve la salud digestiva.[cite: 2]"
        },
        {
          "texto": "Derivado vegetal ⊃ vitaminas.[cite: 2]",
          "explicacion": "Contiene diversas vitaminas.[cite: 2] Son micronutrientes esenciales indispensables para regular funciones metabólicas que humanos no pueden producir eficientemente.[cite: 2]"
        },
        {
          "texto": "Derivado vegetal ⊃ proteínas.[cite: 2]",
          "explicacion": "Contiene proteínas.[cite: 2] Formadas por cadenas de aminoácidos utilizadas para construir y reparar masa muscular.[cite: 2]"
        },
        {
          "texto": "Derivado vegetal ⊃ lípidos.[cite: 2]",
          "explicacion": "Contiene lípidos vegetales.[cite: 2] Son grasas naturales en semillas y frutos que aportan energía de reserva y facilitan absorción de vitaminas.[cite: 2]"
        }
      ]
    },

{
  "curso": "Biología",
  "tema": "Herencia influenciada por el sexo",
  "glosario": {
    "Autosómico": "Relativo a cualquier cromosoma que no sea un cromosoma sexual."
  },
  "theory": [
    {
      "titulo": "Concepto y Calvicie",
      "puntos": [
        {
          "texto": "Genes en autosomas",
          "explicacion": "En la herencia influenciada por el sexo, los genes responsables se ubican en cromosomas autosómicos, no en los cromosomas sexuales."
        },
        {
          "texto": "Influencia hormonal",
          "explicacion": "La expresión del genotipo depende del ambiente hormonal del individuo. Altas concentraciones de testosterona alteran la manifestación del rasgo."
        },
        {
          "texto": "Alelos de calvicie",
          "explicacion": "Para este rasgo, el alelo C predispone a la calvicie, mientras que el alelo c mantiene el fenotipo sano o con cabello."
        },
        {
          "texto": "Fenotipo CC",
          "explicacion": "En estado homocigoto dominante, tanto el varón como la mujer expresan la condición, resultando en un varón calvo y una mujer calva."
        },
        {
          "texto": "Fenotipo Cc",
          "explicacion": "En estado heterocigoto, las hormonas marcan la diferencia: el varón expresa el rasgo (varón calvo), pero la mujer no lo expresa (mujer no calva)."
        },
        {
          "texto": "Fenotipo cc",
          "explicacion": "En estado homocigoto recesivo, el alelo de la calvicie está ausente; por consiguiente, se observa un varón no calvo y una mujer no calva."
        }
      ]
    },

{"curso": "Inglés", "tema": "20. Pronombres Posesivos", "leccion": [{"t": "teoria", "titulo": "La tabla", "regla": "Reemplazan «adjetivo + sustantivo»: It is my book → It is mine. my → mine, your → yours, his → his, her → hers, our → ours, their → theirs.", "ejemplos": [{"en": "It is my bag.", "es": "Es mi bolsa."}, {"en": "It is mine.", "es": "Es mía."}, {"en": "It is hers.", "es": "Es de ella."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: my", "respuestas": ["mine"], "explicacion": "my → mine.", "t": "ej", "id": "n20-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: your", "respuestas": ["yours"], "explicacion": "your → yours.", "t": "ej", "id": "n20-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: her", "respuestas": ["hers"], "explicacion": "her → hers.", "t": "ej", "id": "n20-s01-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: our", "respuestas": ["ours"], "explicacion": "our → ours.", "t": "ej", "id": "n20-s01-e04"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: their", "respuestas": ["theirs"], "explicacion": "their → theirs.", "t": "ej", "id": "n20-s01-e05"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: his", "respuestas": ["his"], "explicacion": "his → his (no cambia).", "t": "ej", "id": "n20-s01-e06"}, {"t": "teoria", "titulo": "Sin sustantivo", "regla": "El pronombre posesivo no lleva sustantivo después: It is mine (no «mine bag»).", "ejemplos": [{"en": "This pen is yours.", "es": "Este bolígrafo es tuyo."}, {"en": "That house is ours.", "es": "Esa casa es nuestra."}, {"en": "The book is his.", "es": "El libro es de él."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "It is my bag. → It is ___.", "respuestas": ["mine"], "explicacion": "my → mine.", "t": "ej", "id": "n20-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is your pen. → It is ___.", "respuestas": ["yours"], "explicacion": "your → yours.", "t": "ej", "id": "n20-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is her house. → It is ___.", "respuestas": ["hers"], "explicacion": "her → hers.", "t": "ej", "id": "n20-s02-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is our car. → It is ___.", "respuestas": ["ours"], "explicacion": "our → ours.", "t": "ej", "id": "n20-s02-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is their book. → It is ___.", "respuestas": ["theirs"], "explicacion": "their → theirs.", "t": "ej", "id": "n20-s02-e05"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is his phone. → It is ___.", "respuestas": ["his"], "explicacion": "his → his.", "t": "ej", "id": "n20-s02-e06"}, {"t": "teoria", "titulo": "Adjetivo o pronombre", "regla": "Con sustantivo: my book. Sin sustantivo: The book is mine.", "ejemplos": [{"en": "This is my book.", "es": "Este es mi libro."}, {"en": "This book is mine.", "es": "Este libro es mío."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "This is ___ book. (mío)", "respuestas": ["my"], "explicacion": "Con sustantivo → my.", "t": "ej", "id": "n20-s03-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "This book is ___. (mío)", "respuestas": ["mine"], "explicacion": "Sin sustantivo → mine.", "t": "ej", "id": "n20-s03-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "That is ___ car. (de ella)", "respuestas": ["her"], "explicacion": "Con sustantivo → her.", "t": "ej", "id": "n20-s03-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "That car is ___. (de ella)", "respuestas": ["hers"], "explicacion": "Sin sustantivo → hers.", "t": "ej", "id": "n20-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Este libro es mío.", "respuestas": ["This book is mine."], "explicacion": "Sin sustantivo → mine.", "t": "ej", "id": "n20-s03-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Esa bolsa es tuya.", "respuestas": ["That bag is yours."], "explicacion": "Sin sustantivo → yours.", "t": "ej", "id": "n20-s03-e06"}, {"t": "teoria", "titulo": "Whose", "regla": "Whose = de quién. Whose bag is this? → It is mine.", "ejemplos": [{"en": "Whose bag is this?", "es": "¿De quién es esta bolsa?"}, {"en": "Whose is this?", "es": "¿De quién es esto?"}, {"en": "It is mine.", "es": "Es mío."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿De quién es esto?", "respuestas": ["Whose is this?"], "explicacion": "Whose + is + this.", "t": "ej", "id": "n20-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿De quién es esa casa?", "respuestas": ["Whose house is that?", "Whose is that house?"], "explicacion": "Whose + sustantivo + is + that.", "t": "ej", "id": "n20-s04-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde: Whose bag is this? (es mía)", "respuestas": ["It is mine.", "It's mine."], "explicacion": "It is + pronombre posesivo.", "t": "ej", "id": "n20-s04-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde: Whose pen is that? (es de ella)", "respuestas": ["It is hers.", "It's hers."], "explicacion": "It is + hers.", "t": "ej", "id": "n20-s04-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ book is this?", "respuestas": ["Whose"], "explicacion": "De quién = whose.", "t": "ej", "id": "n20-s04-e05"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PRONOMBRES POSESIVOS. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: our", "respuestas": ["ours"], "explicacion": "our → ours.", "t": "ej", "id": "n20-s05-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: my", "respuestas": ["mine"], "explicacion": "my → mine.", "t": "ej", "id": "n20-s05-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is her house. → It is ___.", "respuestas": ["hers"], "explicacion": "her → hers.", "t": "ej", "id": "n20-s05-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde: Whose pen is that? (es de ella)", "respuestas": ["It is hers.", "It's hers."], "explicacion": "It is + hers.", "t": "ej", "id": "n20-s05-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Esa bolsa es tuya.", "respuestas": ["That bag is yours."], "explicacion": "Sin sustantivo → yours.", "t": "ej", "id": "n20-s05-e05"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pronombre posesivo de: your", "respuestas": ["yours"], "explicacion": "your → yours.", "t": "ej", "id": "n20-s05-e06"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is your pen. → It is ___.", "respuestas": ["yours"], "explicacion": "your → yours.", "t": "ej", "id": "n20-s05-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿De quién es esa casa?", "respuestas": ["Whose house is that?", "Whose is that house?"], "explicacion": "Whose + sustantivo + is + that.", "t": "ej", "id": "n20-s05-e08"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde: Whose bag is this? (es mía)", "respuestas": ["It is mine.", "It's mine."], "explicacion": "It is + pronombre posesivo.", "t": "ej", "id": "n20-s05-e09"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ book is this?", "respuestas": ["Whose"], "explicacion": "De quién = whose.", "t": "ej", "id": "n20-s05-e10"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is his phone. → It is ___.", "respuestas": ["his"], "explicacion": "his → his.", "t": "ej", "id": "n20-s05-e11"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is my bag. → It is ___.", "respuestas": ["mine"], "explicacion": "my → mine.", "t": "ej", "id": "n20-s05-e12"}, {"tipo": "escribir", "subtipo": "completar", "q": "It is their book. → It is ___.", "res
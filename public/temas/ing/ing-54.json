{"curso": "Inglés", "tema": "54. Much / Many / A Lot Of", "leccion": [{"t": "teoria", "titulo": "Many", "regla": "many + plural contable: many books, many people. Se usa sobre todo en negativas y preguntas.", "ejemplos": [{"en": "I don't have many books.", "es": "No tengo muchos libros."}, {"en": "Are there many people?", "es": "¿Hay mucha gente?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I don't have ___ books.", "respuestas": ["many"], "explicacion": "Plural contable → many.", "t": "ej", "id": "n54-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "Are there ___ people?", "respuestas": ["many"], "explicacion": "Plural contable → many.", "t": "ej", "id": "n54-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No tengo muchos amigos.", "respuestas": ["I don't have many friends.", "I do not have many friends."], "explicacion": "don't + many.", "t": "ej", "id": "n54-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Hay muchos coches?", "respuestas": ["Are there many cars?"], "explicacion": "Are there + many.", "t": "ej", "id": "n54-s01-e04"}, {"t": "teoria", "titulo": "Much", "regla": "much + incontable: much water, much money. Se usa en negativas y preguntas.", "ejemplos": [{"en": "I don't have much money.", "es": "No tengo mucho dinero."}, {"en": "Is there much water?", "es": "¿Hay mucha agua?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I don't have ___ money.", "respuestas": ["much"], "explicacion": "Incontable → much.", "t": "ej", "id": "n54-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "Is there ___ water?", "respuestas": ["much"], "explicacion": "Incontable → much.", "t": "ej", "id": "n54-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No tengo mucho tiempo.", "respuestas": ["I don't have much time.", "I do not have much time."], "explicacion": "don't + much.", "t": "ej", "id": "n54-s02-e03"}, {"
{"curso": "Inglés", "tema": "86. Pasado Simple: Negativo Y Preguntas", "leccion": [{"t": "teoria", "titulo": "Didn't", "regla": "Negativo: did not / didn't + verbo base (sin -ed). I didn't work. She didn't eat.", "ejemplos": [{"en": "I didn't work.", "es": "No trabajé."}, {"en": "She didn't eat rice.", "es": "Ella no comió arroz."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: I worked yesterday.", "respuestas": ["I did not work yesterday.", "I didn't work yesterday."], "explicacion": "didn't + verbo base.", "t": "ej", "id": "n86-s01-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: She ate rice.", "respuestas": ["She did not eat rice.", "She didn't eat rice."], "explicacion": "didn't + eat.", "t": "ej", "id": "n86-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No vimos a Tom.", "respuestas": ["We didn't see Tom.", "We did not see Tom."], "explicacion": "didn't + see.", "t": "ej", "id": "n86-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "They ___ go.", "respuestas": ["didn't"], "explicacion": "didn't + verbo base.", "t": "ej", "id": "n86-s01-e04"}, {"t": "teoria", "titulo": "Preguntas con Did", "regla": "Did + sujeto + verbo base? Did you work? Yes, I did. / No, I didn't.", "ejemplos": [{"en": "Did you work?", "es": "¿Trabajaste?"}, {"en": "Did she eat?", "es": "¿Ella comió?"}, {"en": "Yes, I did.", "es": "Sí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You worked yesterday.", "respuestas": ["Did you work yesterday?"], "explicacion": "Did + sujeto + verbo base.", "t": "ej", "id": "n86-s02-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: She ate rice.", "respuestas": ["Did she eat rice?"], "explicacion": "Did + she + eat.", "t": "ej", "id": "n86-s02-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Did you go home?", "respuestas": ["Yes, I did."], "explicacion": "Yes, I did.", "t": "ej", "id": "n86-s02-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Did they see him?", "respuestas": ["No, they didn't.", "No, they did not."], "explicacion": "No, they didn't.", "t": "ej", "id": "n86-s02-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Compraste una bolsa?", "respuestas": ["Did you buy a bag?"], "explicacion": "Did + you + buy.", "t": "ej", "id": "n86-s02-e05"}, {"t": "teoria", "titulo": "Preguntas con Wh-", "regla": "Wh- + did + sujeto + verbo base? What did you eat? Where did she go?", "ejemplos": [{"en": "What did you eat?", "es": "¿Qué comiste?"}, {"en": "Where did she go?", "es": "¿Adónde fue ella?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Qué comiste?", "respuestas": ["What did you eat?"], "explicacion": "What + did + you + verbo.", "t": "ej", "id": "n86-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Adónde fue ella?", "respuestas": ["Where did she go?"], "explicacion": "Where + did + she + go.", "t": "ej", "id": "n86-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuándo llegaste?", "respuestas": ["When did you come?", "When did you arrive?"], "explicacion": "When + did + you + verbo.", "t": "ej", "id": "n86-s03-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "What ___ you do?", "respuestas": ["did"], "explicacion": "did + sujeto + verbo base.", "t": "ej", "id": "n86-s03-e04"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PASADO SIMPLE: NEGATIVO Y PREGUNTAS. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Did you go home?", "respuestas": ["Yes, I did."], "explicacion": "Yes, I did.", "t": "ej", "id": "n86-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No vimos a Tom.", "respuestas": ["We didn't see Tom.", "We did not see Tom."], "explicacion": "didn't + see.", "t": "ej", "id": "n86-s04-e02"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: She ate rice.", "respuestas": ["Did she eat rice?"], "explicacion": "Did + she + eat.", "t": "ej", "id": "n86-s04-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Compraste una bolsa?", "respuestas": ["Did you buy a bag?"], "explicacion": "Did + you + buy.", "t": "ej", "id": "n86-s04-e04"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You worked yesterday.", "respuestas": ["Did you work yesterday?"], "explicacion": "Did + sujeto + verbo base.", "t": "ej", "id": "n86-s04-e05"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Did they see him?", "respuestas": ["No, they didn't.", "No, they did not."], "explicacion": "No, they didn't.", "t": "ej", "id": "n86-s04-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Adónde fue ella?", "respuestas": ["Where did she go?"], "explicacion": "Where + did + she + go.", "t": "ej", "id": "n86-s04-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Qué comiste?", "respuestas": ["What did you eat?"], "explicacion": "What + did + you + verbo.", "t": "ej", "id": "n86-s04-e08"}, {"tipo": "escribir", "subtipo": "completar", "q": "They ___ go.", "respuestas": ["didn't"], "explicacion": "didn't + verbo base.", "t": "ej", "id": "n86-s04-e09"}, {"tipo": "escribir", "subtipo": "completar", "q": "What ___ you do?", "respuestas": ["did"], "explicacion": "did + sujeto + verbo base.", "t": "ej", "id": "n86-s04-e10"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: I worked yesterday.", "respuestas": ["I did not work yesterday.", "I didn't work yesterday."], "explicacion": "didn't + verbo base.", "t": "ej", "id": "n86-s04-e11"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Cuándo llegaste?", "respuestas": ["When did you come?", "When did you arrive?"], "explicacion": "When + did + you + verbo.", "t": "ej", "id": "n86-s04-e12"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: She ate rice.", "respuestas": ["She did not eat rice.", "She didn't eat rice."], "explicacion": "didn't + eat.", "t": "ej", "id": "n86-s04-e13"}]}
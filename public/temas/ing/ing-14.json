{"curso": "Inglés", "tema": "14. El Artículo The", "leccion": [{"t": "teoria", "titulo": "The", "regla": "the = el, la, los, las. Se usa cuando sabemos de qué cosa hablamos: The book is here.", "ejemplos": [{"en": "The book is here.", "es": "El libro está aquí."}, {"en": "The house is big.", "es": "La casa es grande."}, {"en": "The doors are open.", "es": "Las puertas están abiertas."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ door is here. (la puerta)", "respuestas": ["The"], "explicacion": "the = el/la/los/las.", "t": "ej", "id": "n14-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: El libro está aquí.", "respuestas": ["The book is here."], "explicacion": "the + sustantivo.", "t": "ej", "id": "n14-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: La casa es grande.", "respuestas": ["The house is big."], "explicacion": "the + sustantivo.", "t": "ej", "id": "n14-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Los libros están aquí.", "respuestas": ["The books are here."], "explicacion": "the sirve para plural también.", "t": "ej", "id": "n14-s01-e04"}, {"t": "teoria", "titulo": "A o THE", "regla": "a/an = uno cualquiera (primera vez). the = uno concreto (ya mencionado): I have a dog. The dog is big.", "ejemplos": [{"en": "I have a dog.", "es": "Tengo un perro."}, {"en": "The dog is big.", "es": "El perro es grande."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I have ___ dog.", "respuestas": ["a"], "explicacion": "Primera mención → a.", "t": "ej", "id": "n14-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ dog is big. (el perro que tengo)", "respuestas": ["The"], "explicacion": "Ya mencionado → the.", "t": "ej", "id": "n14-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "I have ___ apple.", "respuestas": ["an"], "explicacion": "Primera mención, vocal → an.", "t": "ej", "id": "n14-s02-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ apple is red.", "respuestas": ["The"], "explicacion": "Ya mencionado → the.", "t": "ej", "id": "n14-s02-e04"}, {"t": "teoria", "titulo": "Cosas únicas", "regla": "Con cosas únicas usa the: the sun, the moon, the world, the internet.", "ejemplos": [{"en": "The sun is hot.", "es": "El sol es caliente."}, {"en": "The moon is white.", "es": "La luna es blanca."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "___ sun is hot.", "respuestas": ["The"], "explicacion": "Único → the.", "t": "ej", "id": "n14-s03-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ moon is white.", "respuestas": ["The"], "explicacion": "Único → the.", "t": "ej", "id": "n14-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: El mundo es grande.", "respuestas": ["The world is big."], "explicacion": "the + world.", "t": "ej", "id": "n14-s03-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: La luna es bonita.", "respuestas": ["The moon is beautiful."], "explicacion": "the + moon.", "t": "ej", "id": "n14-s03-e04"}, {"t": "teoria", "titulo": "Sin artículo", "regla": "No uses artículo con nombres de persona, la mayoría de países, idiomas y con cosas en general: I like coffee. I speak English. I am from Spain.", "ejemplos": [{"en": "I like coffee.", "es": "Me gusta el café."}, {"en": "I speak English.", "es": "Hablo inglés."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I like ___ coffee. (escribe X si no hace falta artículo)", "respuestas": ["X", "x"], "explicacion": "En general → sin artículo.", "t": "ej", "id": "n14-s04-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "I speak ___ English. (X si no hace falta)", "respuestas": ["X", "x"], "explicacion": "Idioma → sin artículo.", "t": "ej", "id": "n14-s04-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "I am from ___ Spain. (X si no hace falta)", "respuestas": ["X", "x"], "explicac
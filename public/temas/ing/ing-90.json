{"curso": "Inglés", "tema": "90. Will", "leccion": [{"t": "teoria", "titulo": "Will", "regla": "will + verbo base: I will help you. It will rain. Igual para todos. Contracción: I'll.", "ejemplos": [{"en": "I will help you.", "es": "Te ayudaré."}, {"en": "It will rain.", "es": "Va a llover."}, {"en": "I'll call you.", "es": "Te llamaré."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Te ayudaré.", "respuestas": ["I will help you.", "I'll help you."], "explicacion": "will + verbo.", "t": "ej", "id": "n90-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Va a llover.", "respuestas": ["It will rain.", "It'll rain."], "explicacion": "will + verbo.", "t": "ej", "id": "n90-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella trabajará mañana.", "respuestas": ["She will work tomorrow.", "She'll work tomorrow."], "explicacion": "will sin -s.", "t": "ej", "id": "n90-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "They ___ come.", "respuestas": ["will"], "explicacion": "will + verbo.", "t": "ej", "id": "n90-s01-e04"}, {"t": "teoria", "titulo": "Negativo y preguntas", "regla": "Negativo: will not = won't. Pregunta: Will you come?", "ejemplos": [{"en": "I won't go.", "es": "No iré."}, {"en": "Will you help me?", "es": "¿Me ayudarás?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: She will come.", "respuestas": ["She will not come.", "She won't come."], "explicacion": "won't.", "t": "ej", "id": "n90-s02-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You will help me.", "respuestas": ["Will you help me?"], "explicacion": "Will + you.", "t": "ej", "id": "n90-s02-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Will you come?", "respuestas": ["Yes, I will."], "explicacion": "Yes, I will.", "t": "ej", "id": "n90-s02-e03"}, {"tipo": "escribir", "subtipo": "responder", "
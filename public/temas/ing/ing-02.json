    {
      "id": "n02-s01",
      "orden": 1,
      "titulo": "I, you, we",
      "teoria": "En inglés **siempre** se dice el sujeto: I am tired (no «Am tired»). **I** siempre va con mayúscula. **you** = tú, usted o ustedes. **we** = nosotros.",
      "ejemplos": [
        {
          "en": "I am a student.",
          "es": "Soy estudiante."
        },
        {
          "en": "You are happy.",
          "es": "Estás feliz."
        },
        {
          "en": "We are here.",
          "es": "Estamos aquí."
        }
      ],
      "vocabulario": [],

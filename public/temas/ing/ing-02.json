{
  "curso": "Inglés",
  "tema": "2. Pronombres Sujeto",
  "leccion": [
    {
      "t": "teoria",
      "titulo": "I, you, we",
      "regla": "En inglés siempre se dice el sujeto: I am tired (no «Am tired»). I siempre va con mayúscula. you = tú, usted o ustedes. we = nosotros.",
      "ejemplos": [
        {
          "en": "I am a student.",
          "es": "Soy estudiante."
        },
        {
          "en": "You are happy.",
          "es": "Estás feliz."
        },
        {
          "en": "We are here.",
          "es": "Estamos aquí."
        }
      ],
      "vocab": []
    },
    {
      "tipo": "escribir",
      "subtipo": "completar",
      "q": "___ am tired. (yo)",
      "respuestas": [
        "I"
      ],
      "explicacion": "yo = I.",
      "t": "ej",
      "id": "n02-s01-e01"
    },
    {
      "tipo": "escribir",
      "subtipo": "completar",
      "q": "___ are happy. (tú)",
      "respuestas": [
        "You"
      ],
      "explicacion": "tú = you.",
      "t": "ej",
      "id": "n02-s01-e02"
    },
    {
      "tipo": "escribir",
      "subtipo": "completar",
      "q": "___ are students. (nosotros)",
      "respuestas": [
        "We"
      ],
      "explicacion": "nosotros = we.",
      "t": "ej",
      "id": "n02-s01-e03"
    },
    {
      "tipo": "escribir",
      "subtipo": "escribir_palabra",
      "q": "Escribe el pronombre para: nosotros",
      "respuestas": [
        "we"
      ],
      "explicacion": "nosotros = we.",
      "t": "ej",
      "id": "n02-s01-e04"
    },
    {
      "tipo": "escribir",
      "subtipo": "traducir",
      "q": "Escribe en inglés: Estoy cansado.",
      "respuestas": [
        "I am tired.",
        "I'm tired."
      ],
      "explicacion": "No se omite el sujeto: I am.",
      "t": "ej",
      "id": "n02-s01-e05"
    },
    {
      "tipo": "escribir",
      "subtipo": "traducir",

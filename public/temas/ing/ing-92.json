{"curso": "Inglés", "tema": "92. Pronombres Reflexivos", "leccion": [{"t": "teoria", "titulo": "La tabla", "regla": "I → myself, you → yourself, he → himself, she → herself, it → itself, we → ourselves, you (varios) → yourselves, they → themselves.", "ejemplos": [{"en": "I see myself.", "es": "Me veo a mí mismo."}, {"en": "She hurts herself.", "es": "Ella se lastima."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: I", "respuestas": ["myself"], "explicacion": "I → myself.", "t": "ej", "id": "n92-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: he", "respuestas": ["himself"], "explicacion": "he → himself.", "t": "ej", "id": "n92-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: she", "respuestas": ["herself"], "explicacion": "she → herself.", "t": "ej", "id": "n92-s01-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: we", "respuestas": ["ourselves"], "explicacion": "we → ourselves.", "t": "ej", "id": "n92-s01-e04"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: they", "respuestas": ["themselves"], "explicacion": "they → themselves.", "t": "ej", "id": "n92-s01-e05"}, {"t": "teoria", "titulo": "Cuándo usarlos", "regla": "Cuando el sujeto y el objeto son iguales: I see myself. No los uses si son distintos: I see him.", "ejemplos": [{"en": "I cut myself.", "es": "Me corté."}, {"en": "He looks at himself.", "es": "Él se mira."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I see ___. (a mí mismo)", "respuestas": ["myself"], "explicacion": "mismo sujeto y objeto.", "t": "ej", "id": "n92-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "She cuts ___. (a sí misma)", "respuestas": ["herself"], "explicacion": "she → herself.", "t": "ej", "id": "n92-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "I see ___. (a él)", "respuestas": ["him"], "explicacion": "personas distintas → him.", "t": "ej", "id": "n92-s02-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él se mira.", "respuestas": ["He looks at himself."], "explicacion": "himself.", "t": "ej", "id": "n92-s02-e04"}, {"t": "teoria", "titulo": "By myself", "regla": "by myself = yo solo, sin ayuda: I cook by myself. She lives by herself.", "ejemplos": [{"en": "I cook by myself.", "es": "Cocino yo solo."}, {"en": "She lives by herself.", "es": "Ella vive sola."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Cocino yo solo.", "respuestas": ["I cook by myself."], "explicacion": "by myself.", "t": "ej", "id": "n92-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella vive sola.", "respuestas": ["She lives by herself."], "explicacion": "by herself.", "t": "ej", "id": "n92-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos trabajan solos.", "respuestas": ["They work by themselves."], "explicacion": "by themselves.", "t": "ej", "id": "n92-s03-e03"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PRONOMBRES REFLEXIVOS. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I see ___. (a él)", "respuestas": ["him"], "explicacion": "personas distintas → him.", "t": "ej", "id": "n92-s04-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "I see ___. (a mí mismo)", "respuestas": ["myself"], "explicacion": "mismo sujeto y objeto.", "t": "ej", "id": "n92-s04-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "She cuts ___. (a sí misma)", "respuestas": ["herself"], "explicacion": "she → herself.", "t": "ej", "id": "n92-s04-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: he", "respuestas": ["himself"], "explicacion": "he → himself.", "t": "ej", "id": "n92-s04-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos trabajan solos.", "respuestas": ["They work by themselves."], "explicacion": "by themselves.", "t": "ej", "id": "n92-s04-e05"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: they", "respuestas": ["themselves"], "explicacion": "they → themselves.", "t": "ej", "id": "n92-s04-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Cocino yo solo.", "respuestas": ["I cook by myself."], "explicacion": "by myself.", "t": "ej", "id": "n92-s04-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella vive sola.", "respuestas": ["She lives by herself."], "explicacion": "by herself.", "t": "ej", "id": "n92-s04-e08"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él se mira.", "respuestas": ["He looks at himself."], "explicacion": "himself.", "t": "ej", "id": "n92-s04-e09"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: I", "respuestas": ["myself"], "explicacion": "I → myself.", "t": "ej", "id": "n92-s04-e10"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: she", "respuestas": ["herself"], "explicacion": "she → herself.", "t": "ej", "id": "n92-s04-e11"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Reflexivo de: we", "respuestas": ["ourselves"], "explicacion": "we → ourselves.", "t": "ej", "id": "n92-s04-e12"}]}
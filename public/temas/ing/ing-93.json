{"curso": "Inglés", "tema": "93. Pronombres Indefinidos", "leccion": [{"t": "teoria", "titulo": "Some-", "regla": "someone / somebody = alguien. something = algo. somewhere = en algún lugar. Se usan en afirmativas: Someone is here.", "ejemplos": [{"en": "Someone is here.", "es": "Alguien está aquí."}, {"en": "I want something.", "es": "Quiero algo."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Alguien está aquí.", "respuestas": ["Someone is here.", "Somebody is here."], "explicacion": "someone.", "t": "ej", "id": "n93-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Quiero algo.", "respuestas": ["I want something."], "explicacion": "something.", "t": "ej", "id": "n93-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "There is ___ in the house. (alguien)", "respuestas": ["someone", "somebody"], "explicacion": "someone / somebody.", "t": "ej", "id": "n93-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "I see ___ in the bag. (algo)", "respuestas": ["something"], "explicacion": "something.", "t": "ej", "id": "n93-s01-e04"}, {"t": "teoria", "titulo": "Any-", "regla": "anyone / anybody, anything, anywhere se usan en negativas y preguntas: I don't see anyone. Do you want anything?", "ejemplos": [{"en": "I don't see anyone.", "es": "No veo a nadie."}, {"en": "Do you want anything?", "es": "¿Quieres algo?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No veo a nadie.", "respuestas": ["I don't see anyone.", "I do not see anyone.", "I don't see anybody."], "explicacion": "negativa → anyone.", "t": "ej", "id": "n93-s02-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Quieres algo?", "respuestas": ["Do you want anything?"], "explicacion": "pregunta → anything.", "t": "ej", "id": "n93-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "I don't want ___. (nada)", "respuestas": ["anything"], "explicacion": "negativa → anything.", "t": "ej", "id": "n93-s02-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "Is there ___ here? (alguien)", "respuestas": ["anyone", "anybody"], "explicacion": "pregunta → anyone.", "t": "ej", "id": "n93-s02-e04"}, {"t": "teoria", "titulo": "No- y Every-", "regla": "nobody / no one = nadie. nothing = nada. everyone = todos. everything = todo. Nobody is here.", "ejemplos": [{"en": "Nobody is here.", "es": "Nadie está aquí."}, {"en": "Everyone is happy.", "es": "Todos están felices."}, {"en": "Everything is fine.", "es": "Todo está bien."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Nadie está aquí.", "respuestas": ["Nobody is here.", "No one is here."], "explicacion": "nobody.", "t": "ej", "id": "n93-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Todos están felices.", "respuestas": ["Everyone is happy."], "explicacion": "everyone.", "t": "ej", "id": "n93-s03-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Todo está bien.", "respuestas": ["Everything is fine."], "explicacion": "everything.", "t": "ej", "id": "n93-s03-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is in the room. (nada)", "respuestas": ["Nothing"], "explicacion": "nothing.", "t": "ej", "id": "n93-s03-e04"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PRONOMBRES INDEFINIDOS. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Alguien está aquí.", "respuestas": ["Someone is here.", "Somebody is here."], "explicacion": "someone.", "t": "ej", "id": "n93-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Todos están felices.", "respuestas": ["Everyone is happy."], "explicacion": "everyone.", "t": "ej", "id": "n93-s04-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "There is ___ in the house. (alguien)", "respuestas": ["someone", "somebody"], "explicacion": "someone / somebody.", "t": "ej", "id": "n93-s04-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "___ is in the room. (nada)", "respuestas": ["Nothing"], "explicacion": "nothing.", "t": "ej", "id": "n93-s04-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Quiero algo.", "respuestas": ["I want something."], "explicacion": "something.", "t": "ej", "id": "n93-s04-e05"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Quieres algo?", "respuestas": ["Do you want anything?"], "explicacion": "pregunta → anything.", "t": "ej", "id": "n93-s04-e06"}, {"tipo": "escribir", "subtipo": "completar", "q": "Is there ___ here? (alguien)", "respuestas": ["anyone", "anybody"], "explicacion": "pregunta → anyone.", "t": "ej", "id": "n93-s04-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Nadie está aquí.", "respuestas": ["Nobody is here.", "No one is here."], "explicacion": "nobody.", "t": "ej", "id": "n93-s04-e08"}, {"tipo": "escribir", "subtipo": "completar", "q": "I don't want ___. (nada)", "respuestas": ["anything"], "explicacion": "negativa → anything.", "t": "ej", "id": "n93-s04-e09"}, {"tipo": "escribir", "subtipo": "completar", "q": "I see ___ in the bag. (algo)", "respuestas": ["something"], "explicacion": "something.", "t": "ej", "id": "n93-s04-e10"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No veo a nadie.", "respuestas": ["I don't see anyone.", "I do not see anyone.", "I don't see anybody."], "explicacion": "negativa → anyone.", "t": "ej", "id": "n93-s04-e11"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Todo está bien.", "respuestas": ["Everything is fine."], "explicacion": "everything.", "t": "ej", "id": "n93-s04-e12"}]}
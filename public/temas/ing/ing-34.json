{"curso": "Inglés", "tema": "34. Presente Simple (−)", "leccion": [{"t": "teoria", "titulo": "Do not / don't", "regla": "Para negar: sujeto + do not + verbo base. Contracción: don't. I do not eat bread. = I don't eat bread.", "ejemplos": [{"en": "I do not eat bread.", "es": "No como pan."}, {"en": "We don't live here.", "es": "No vivimos aquí."}, {"en": "They don't speak English.", "es": "Ellos no hablan inglés."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: I work here.", "respuestas": ["I do not work here.", "I don't work here."], "explicacion": "Negativo: do not / don't + verbo base.", "t": "ej", "id": "n34-s01-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: We drink water.", "respuestas": ["We do not drink water.", "We don't drink water."], "explicacion": "Negativo: do not / don't + verbo base.", "t": "ej", "id": "n34-s01-e02"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: They speak English.", "respuestas": ["They do not speak English.", "They don't speak English."], "explicacion": "Negativo: do not / don't + verbo base.", "t": "ej", "id": "n34-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "We ___ live here. (no)", "respuestas": ["don't"], "explicacion": "do not / don't.", "t": "ej", "id": "n34-s01-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "I do ___ like coffee.", "respuestas": ["not"], "explicacion": "do + not.", "t": "ej", "id": "n34-s01-e05"}, {"t": "teoria", "titulo": "Producir negativas", "regla": "Traduce frases negativas completas.", "ejemplos": [{"en": "You don't like rice.", "es": "No te gusta el arroz."}, {"en": "I don't want water.", "es": "No quiero agua."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No como pan.", "respuestas": ["I do not eat bread.", "I don't eat bread."], "explicacion": "I + don't + verbo.", "t": "ej", "id": "n34-s02-e01"}, {"tipo": "escribir", "subtipo":
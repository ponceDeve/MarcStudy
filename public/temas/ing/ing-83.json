{"curso": "Inglés", "tema": "83. Pasado Simple Regular", "leccion": [{"t": "teoria", "titulo": "Verbo + -ed", "regla": "Verbos regulares: + -ed. work → worked, play → played, watch → watched. Igual para todos los sujetos.", "ejemplos": [{"en": "I worked yesterday.", "es": "Ayer trabajé."}, {"en": "She watched TV.", "es": "Ella vio televisión."}, {"en": "They played soccer.", "es": "Ellos jugaron fútbol."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: work", "respuestas": ["worked"], "explicacion": "+ ed.", "t": "ej", "id": "n83-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: play", "respuestas": ["played"], "explicacion": "+ ed.", "t": "ej", "id": "n83-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: watch", "respuestas": ["watched"], "explicacion": "+ ed.", "t": "ej", "id": "n83-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ayer trabajé.", "respuestas": ["I worked yesterday."], "explicacion": "verbo + ed.", "t": "ej", "id": "n83-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella vio televisión ayer.", "respuestas": ["She watched TV yesterday."], "explicacion": "verbo + ed.", "t": "ej", "id": "n83-s01-e05"}, {"t": "teoria", "titulo": "Reglas de escritura", "regla": "Termina en e: + d (live → lived). Consonante + y: -ied (study → studied). Consonante corta: dobla (stop → stopped).", "ejemplos": [{"en": "I lived here.", "es": "Viví aquí."}, {"en": "She studied English.", "es": "Ella estudió inglés."}, {"en": "We stopped.", "es": "Paramos."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: live", "respuestas": ["lived"], "explicacion": "+ d.", "t": "ej", "id": "n83-s02-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: study", "respuestas": ["studied"], "explicacion": "y → ied.", "t": "ej", "id": "n83-s02-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: stop", "respuestas": ["stopped"], "explicacion": "dobla la p.", "t": "ej", "id": "n83-s02-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: dance", "respuestas": ["danced"], "explicacion": "+ d.", "t": "ej", "id": "n83-s02-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella estudió inglés.", "respuestas": ["She studied English."], "explicacion": "study → studied.", "t": "ej", "id": "n83-s02-e05"}, {"t": "teoria", "titulo": "Pronunciación de -ed", "regla": "-ed suena /t/ (worked), /d/ (played) o /ɪd/ (wanted, needed).", "ejemplos": [{"en": "worked /wɜːrkt/", "es": "trabajó"}, {"en": "played /pleɪd/", "es": "jugó"}, {"en": "wanted /ˈwɑːntɪd/", "es": "quiso"}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Cómo se pronuncia -ed en «wanted»? (/t/, /d/ o /ɪd/)", "respuestas": ["/ɪd/", "ɪd", "id"], "explicacion": "Después de t o d suena /ɪd/.", "t": "ej", "id": "n83-s03-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Cómo se pronuncia -ed en «worked»? (/t/, /d/ o /ɪd/)", "respuestas": ["/t/", "t"], "explicacion": "Sonido sordo → /t/.", "t": "ej", "id": "n83-s03-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Cómo se pronuncia -ed en «played»? (/t/, /d/ o /ɪd/)", "respuestas": ["/d/", "d"], "explicacion": "Sonido sonoro → /d/.", "t": "ej", "id": "n83-s03-e03"}, {"t": "teoria", "titulo": "Practicar", "regla": "Practica frases completas en pasado.", "ejemplos": [{"en": "They watched TV last night.", "es": "Anoche vieron televisión."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Anoche vimos televisión.", "respuestas": ["We watched TV last night."], "explicacion": "watched.", "t": "ej", "id": "n83-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos jugaron aquí ayer.", "respuestas": ["They played here yesterday."], "explicacion": "played.", "t": "ej", "id": "n83-s04-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella cocinó arroz.", "respuestas": ["She cooked rice."], "explicacion": "cooked.", "t": "ej", "id": "n83-s04-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Yo viví en México.", "respuestas": ["I lived in Mexico."], "explicacion": "lived.", "t": "ej", "id": "n83-s04-e04"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PASADO SIMPLE REGULAR. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: work", "respuestas": ["worked"], "explicacion": "+ ed.", "t": "ej", "id": "n83-s05-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: live", "respuestas": ["lived"], "explicacion": "+ d.", "t": "ej", "id": "n83-s05-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella vio televisión ayer.", "respuestas": ["She watched TV yesterday."], "explicacion": "verbo + ed.", "t": "ej", "id": "n83-s05-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos jugaron aquí ayer.", "respuestas": ["They played here yesterday."], "explicacion": "played.", "t": "ej", "id": "n83-s05-e04"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Pasado de: study", "respuestas": ["studied"], "explicacion": "y → ied.", "t": "ej", "id": "n83-s05-e05"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "¿Cómo se pronuncia -ed en «worked»? (/t/, /d/ o /ɪd/)", "respuestas": ["/t/", "t"], "explicacion": "Sonido sordo → /t/.", "t": "ej", "id": "n83-s05-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Yo viví en México.", "respuestas": ["I lived in Mexico."], "explicacion": "lived.", "t": "ej", "id": "n83-s05-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella estudió inglés.", "respuestas": ["She studied English."], "explicacion": "st
{"curso": "Inglés", "tema": "33. Presente Simple (+)", "leccion": [{"t": "teoria", "titulo": "Estructura", "regla": "Presente simple = lo que haces normalmente. Sujeto + verbo. Con I, you, we, they el verbo no cambia: I eat bread.", "ejemplos": [{"en": "I eat bread.", "es": "Como pan."}, {"en": "We drink water.", "es": "Bebemos agua."}, {"en": "They speak English.", "es": "Ellos hablan inglés."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ bread. (comer)", "respuestas": ["eat"], "explicacion": "I + verbo base.", "t": "ej", "id": "n33-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "We ___ water. (beber)", "respuestas": ["drink"], "explicacion": "We + verbo base.", "t": "ej", "id": "n33-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "They ___ English. (hablar)", "respuestas": ["speak"], "explicacion": "They + verbo base.", "t": "ej", "id": "n33-s01-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "You ___ here. (trabajar)", "respuestas": ["work"], "explicacion": "You + verbo base.", "t": "ej", "id": "n33-s01-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "I ___ here. (vivir)", "respuestas": ["live"], "explicacion": "I + verbo base.", "t": "ej", "id": "n33-s01-e05"}, {"t": "teoria", "titulo": "Traducir hábitos", "regla": "Practica frases completas: sujeto + verbo + complemento.", "ejemplos": [{"en": "I work here.", "es": "Trabajo aquí."}, {"en": "We live here.", "es": "Vivimos aquí."}, {"en": "You read books.", "es": "Lees libros."}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Trabajo aquí.", "respuestas": ["I work here."], "explicacion": "I + verbo.", "t": "ej", "id": "n33-s02-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Vivimos aquí.", "respuestas": ["We live here."], "explicacion": "We + verbo.", "t": "ej", "id": "n33-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos estudian inglés.", "r
uestas": ["Can you speak English?"], "explicacion": "Can + you + verbo.", "t": "ej", "id": "n61-s05-e09"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No podemos trabajar aquí.", "respuestas": ["We cannot work here.", "We can't work here."], "explicacion": "can't + verbo.", "t": "ej", "id": "n61-s05-e10"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Can she cook?", "respuestas": ["No, she cannot.", "No, she can't."], "explicacion": "No, she can't.", "t": "ej", "id": "n61-s05-e11"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos pueden hablar inglés.", "respuestas": ["They can speak English."], "explicacion": "can + verbo base.", "t": "ej", "id": "n61-s05-e12"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Puedo sentarme aquí?", "respuestas": ["Can I sit here?"], "explicacion": "Can I + verbo.", "t": "ej", "id": "n61-s05-e13"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Puedo tener agua?", "respuestas": ["Can I have some water?", "Can I have water?"], "explicacion": "Can I have + cosa.", "t": "ej", "id": "n61-s05-e14"}]}
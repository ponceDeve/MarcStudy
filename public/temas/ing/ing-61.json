{"curso": "Inglés", "tema": "61. Can / Can'T", "leccion": [{"t": "teoria", "titulo": "Can", "regla": "can = poder / saber hacer. Sujeto + can + verbo base, igual para todos: I can swim. She can swim.", "ejemplos": [{"en": "I can swim.", "es": "Sé nadar."}, {"en": "She can cook.", "es": "Ella sabe cocinar."}, {"en": "They can speak English.", "es": "Ellos pueden hablar inglés."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ swim. (puede)", "respuestas": ["can"], "explicacion": "can no lleva -s.", "t": "ej", "id": "n61-s01-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Sé nadar.", "respuestas": ["I can swim."], "explicacion": "can + verbo base.", "t": "ej", "id": "n61-s01-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella sabe cocinar.", "respuestas": ["She can cook."], "explicacion": "She can + verbo (sin -s).", "t": "ej", "id": "n61-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos pueden hablar inglés.", "respuestas": ["They can speak English."], "explicacion": "can + verbo base.", "t": "ej", "id": "n61-s01-e04"}, {"t": "teoria", "titulo": "Can't", "regla": "Negativo: cannot / can't. I can't swim.", "ejemplos": [{"en": "I can't swim.", "es": "No sé nadar."}, {"en": "He cannot cook.", "es": "Él no sabe cocinar."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: I can swim.", "respuestas": ["I cannot swim.", "I can't swim.", "I can not swim."], "explicacion": "can't / cannot.", "t": "ej", "id": "n61-s02-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: She can cook.", "respuestas": ["She cannot cook.", "She can't cook."], "explicacion": "can't / cannot.", "t": "ej", "id": "n61-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: No podemos trabajar aquí.", "respuestas": ["We cannot work here.", "We can't work here."], "explicacion": "can't + verbo.", "t": "ej", "id": "n61-s02-e03"}, {"t": "teoria", "titulo": "Preguntas", "regla": "Pregunta: Can + sujeto + verbo? Can you swim? Yes, I can. / No, I can't.", "ejemplos": [{"en": "Can you swim?", "es": "¿Sabes nadar?"}, {"en": "Yes, I can.", "es": "Sí, sé."}, {"en": "No, I can't.", "es": "No, no sé."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You can swim.", "respuestas": ["Can you swim?"], "explicacion": "Can + sujeto + verbo.", "t": "ej", "id": "n61-s03-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: She can cook.", "respuestas": ["Can she cook?"], "explicacion": "Can + sujeto + verbo.", "t": "ej", "id": "n61-s03-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Can you swim?", "respuestas": ["Yes, I can."], "explicacion": "Yes, I can.", "t": "ej", "id": "n61-s03-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Can she cook?", "respuestas": ["No, she cannot.", "No, she can't."], "explicacion": "No, she can't.", "t": "ej", "id": "n61-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Puedes hablar inglés?", "respuestas": ["Can you speak English?"], "explicacion": "Can + you + verbo.", "t": "ej", "id": "n61-s03-e05"}, {"t": "teoria", "titulo": "Pedir permiso", "regla": "Can I...? pide permiso: Can I sit here? Can I have some water?", "ejemplos": [{"en": "Can I sit here?", "es": "¿Puedo sentarme aquí?"}, {"en": "Can I have some water?", "es": "¿Me das agua?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Puedo sentarme aquí?", "respuestas": ["Can I sit here?"], "explicacion": "Can I + verbo.", "t": "ej", "id": "n61-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Puedo tener agua?", "respuestas": ["Can I have some water?", "Can I have water?"], "explicacion": "Can I have + cosa.", "t": "ej", "id": "n61-s04-e02"}, {"tipo": "escribir", "s
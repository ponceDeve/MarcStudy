{"curso": "Inglés", "tema": "35. Presente Simple (?)", "leccion": [{"t": "teoria", "titulo": "Preguntas con Do", "regla": "Pregunta: Do + sujeto + verbo base? Do you work here? Do they live here?", "ejemplos": [{"en": "Do you work here?", "es": "¿Trabajas aquí?"}, {"en": "Do they live here?", "es": "¿Ellos viven aquí?"}, {"en": "Do we like rice?", "es": "¿Nos gusta el arroz?"}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You work here.", "respuestas": ["Do you work here?"], "explicacion": "Do + sujeto + verbo.", "t": "ej", "id": "n35-s01-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: They live here.", "respuestas": ["Do they live here?"], "explicacion": "Do + sujeto + verbo.", "t": "ej", "id": "n35-s01-e02"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You like coffee.", "respuestas": ["Do you like coffee?"], "explicacion": "Do + sujeto + verbo.", "t": "ej", "id": "n35-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Hablas inglés?", "respuestas": ["Do you speak English?"], "explicacion": "Do + you + verbo.", "t": "ej", "id": "n35-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Queremos agua?", "respuestas": ["Do we want water?"], "explicacion": "Do + we + verbo.", "t": "ej", "id": "n35-s01-e05"}, {"t": "teoria", "titulo": "Respuestas cortas", "regla": "Responde con Yes, I do. o No, I do not / don't. Al final de una respuesta afirmativa no se contrae.", "ejemplos": [{"en": "Do you like coffee? Yes, I do.", "es": "¿Te gusta el café? Sí."}, {"en": "Do they live here? No, they don't.", "es": "¿Viven aquí? No."}], "vocab": []}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Do you like coffee?", "respuestas": ["Yes, I do."], "explicacion": "Yes, + sujeto + do.", "t": "ej", "id": "n35-s02-e01"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Do you work here?", "respuestas": ["No, I do not.", "No, I don't."], "explicacion": "No, + sujeto + don't.", "t": "ej", "id": "n35-s02-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Do they live here?", "respuestas": ["Yes, they do."], "explicacion": "Yes, they do.", "t": "ej", "id": "n35-s02-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Do you want water?", "respuestas": ["No, I do not.", "No, I don't."], "explicacion": "No, I don't.", "t": "ej", "id": "n35-s02-e04"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Do we like rice?", "respuestas": ["Yes, we do."], "explicacion": "Yes, we do.", "t": "ej", "id": "n35-s02-e05"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PRESENTE SIMPLE (?). No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You like coffee.", "respuestas": ["Do you like coffee?"], "explicacion": "Do + sujeto + verbo.", "t": "ej", "id": "n35-s03-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Queremos agua?", "respuestas": ["Do we want water?"], "explicacion": "Do + we + verbo.", "t": "ej", "id": "n35-s03-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Do they live here?", "respuestas": ["Yes, they do."], "explicacion": "Yes, they do.", "t": "ej", "id": "n35-s03-e03"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: You work here.", "respuestas": ["Do you work here?"], "explicacion": "Do + sujeto + verbo.", "t": "ej", "id": "n35-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: ¿Hablas inglés?", "respuestas": ["Do you speak English?"], "explicacion": "Do + you + verbo.", "t": "ej", "id": "n35-s03-e05"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Do we like rice?", "respuestas": ["Yes, we do."], "explicacion": "Yes, we do.", "t": "ej", "id"
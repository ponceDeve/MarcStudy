{"curso": "Inglés", "tema": "36. Presente Simple He / She / It", "leccion": [{"t": "teoria", "titulo": "Verbo + -s", "regla": "Con he, she, it el verbo lleva -s: I work → he works. I eat → she eats.", "ejemplos": [{"en": "He works here.", "es": "Él trabaja aquí."}, {"en": "She eats bread.", "es": "Ella come pan."}, {"en": "He drinks water.", "es": "Él bebe agua."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "He ___ here. (work)", "respuestas": ["works"], "explicacion": "he + verbo + s.", "t": "ej", "id": "n36-s01-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ coffee. (drink)", "respuestas": ["drinks"], "explicacion": "she + verbo + s.", "t": "ej", "id": "n36-s01-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "He ___ English. (speak)", "respuestas": ["speaks"], "explicacion": "he + verbo + s.", "t": "ej", "id": "n36-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella come pan.", "respuestas": ["She eats bread."], "explicacion": "she + verbo + s.", "t": "ej", "id": "n36-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él lee libros.", "respuestas": ["He reads books."], "explicacion": "he + verbo + s.", "t": "ej", "id": "n36-s01-e05"}, {"t": "teoria", "titulo": "-es, has", "regla": "Si termina en s, sh, ch, o: -es (watch → watches, go → goes). Consonante + y: -ies (study → studies). have → has.", "ejemplos": [{"en": "She watches TV.", "es": "Ella ve televisión."}, {"en": "He studies English.", "es": "Él estudia inglés."}, {"en": "She has a book.", "es": "Ella tiene un libro."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ TV. (watch)", "respuestas": ["watches"], "explicacion": "ch → -es.", "t": "ej", "id": "n36-s02-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ English. (study)", "respuestas": ["studies"], "explicacion": "consonante + y → -ies.", "t": "ej", "id": "n36-s02-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "He ___ a car. (have)", "respuestas": ["has"], "explicacion": "have → has.", "t": "ej", "id": "n36-s02-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe: he (go)", "respuestas": ["goes"], "explicacion": "o → -es.", "t": "ej", "id": "n36-s02-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él estudia inglés.", "respuestas": ["He studies English."], "explicacion": "study → studies.", "t": "ej", "id": "n36-s02-e05"}, {"t": "teoria", "titulo": "Does y doesn't", "regla": "Negativo: does not / doesn't + verbo base (sin -s). Pregunta: Does + he/she/it + verbo base?", "ejemplos": [{"en": "He doesn't work here.", "es": "Él no trabaja aquí."}, {"en": "Does she like coffee?", "es": "¿Le gusta el café a ella?"}, {"en": "Yes, she does.", "es": "Sí."}], "vocab": []}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: He works here.", "respuestas": ["He does not work here.", "He doesn't work here."], "explicacion": "does not / doesn't + verbo base.", "t": "ej", "id": "n36-s03-e01"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: She likes coffee.", "respuestas": ["Does she like coffee?"], "explicacion": "Does + she + verbo base.", "t": "ej", "id": "n36-s03-e02"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Does she work here?", "respuestas": ["Yes, she does."], "explicacion": "Yes, she does.", "t": "ej", "id": "n36-s03-e03"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Does he like rice?", "respuestas": ["No, he does not.", "No, he doesn't."], "explicacion": "No, he doesn't.", "t": "ej", "id": "n36-s03-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella no come pan.", "respuestas": ["She does not eat bread.", "She doesn't eat bread."], "explicacion": "She + doesn't + verbo base.", "t": "ej", "id": "n36-s03-e05"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en PRESENTE SIMPLE HE / SHE / IT. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (sí): Does she work here?", "respuestas": ["Yes, she does."], "explicacion": "Yes, she does.", "t": "ej", "id": "n36-s04-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él estudia inglés.", "respuestas": ["He studies English."], "explicacion": "study → studies.", "t": "ej", "id": "n36-s04-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "He ___ here. (work)", "respuestas": ["works"], "explicacion": "he + verbo + s.", "t": "ej", "id": "n36-s04-e03"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe en negativo: He works here.", "respuestas": ["He does not work here.", "He doesn't work here."], "explicacion": "does not / doesn't + verbo base.", "t": "ej", "id": "n36-s04-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él lee libros.", "respuestas": ["He reads books."], "explicacion": "he + verbo + s.", "t": "ej", "id": "n36-s04-e05"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Escribe: he (go)", "respuestas": ["goes"], "explicacion": "o → -es.", "t": "ej", "id": "n36-s04-e06"}, {"tipo": "escribir", "subtipo": "completar", "q": "He ___ English. (speak)", "respuestas": ["speaks"], "explicacion": "he + verbo + s.", "t": "ej", "id": "n36-s04-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella come pan.", "respuestas": ["She eats bread."], "explicacion": "she + verbo + s.", "t": "ej", "id": "n36-s04-e08"}, {"tipo": "escribir", "subtipo": "responder", "q": "Responde (no): Does he like rice?", "respuestas": ["No, he does not.", "No, he doesn't."], "explicacion": "No, he doesn't.", "t": "ej", "id": "n36-s04-e09"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ English. (study)", "respuestas": ["studies"], "explicacion": "consonante + y → -ies.", "t": "ej", "id": "n36-s04-e10"}, {"tipo": "escribir", "subtipo": "completar", "q": "He ___ a car. (have)", "respuestas": ["has"], "explicacion": "have → has.", "t": "ej", "id": "n36-s04-e11"}, {"tipo": "escribir", "subtipo": "transformar", "q": "Escribe como pregunta: She likes coffee.", "respuestas": ["Does she like coffee?"], "explicacion": "Does + she + verbo base.", "t": "ej", "id": "n36-s04-e12"}, {"tipo": "escribir", "subtipo": "completar", "q": "She ___ coffee. (drink)", "respuestas": ["drinks"], "explicacion": "she + verbo + s.", "t": "ej", "id": "n36-s04-e13"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella no come pan.", "respuestas": ["She does not eat bread.", "She doesn't eat bread."], "explicacion": "She + doesn't + verbo base.", "t": "ej", "id": "n36-s04-e14"}]}
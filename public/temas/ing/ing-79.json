{"curso": "Inglés", "tema": "79. Adverbios De Modo", "leccion": [{"t": "teoria", "titulo": "Adjetivo + ly", "regla": "Muchos adverbios se forman adjetivo + -ly: slow → slowly, quick → quickly, careful → carefully. Van después del verbo: She walks slowly.", "ejemplos": [{"en": "She walks slowly.", "es": "Ella camina despacio."}, {"en": "He speaks quickly.", "es": "Él habla rápido."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: slow", "respuestas": ["slowly"], "explicacion": "+ ly.", "t": "ej", "id": "n79-s01-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: quick", "respuestas": ["quickly"], "explicacion": "+ ly.", "t": "ej", "id": "n79-s01-e02"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: careful", "respuestas": ["carefully"], "explicacion": "+ ly.", "t": "ej", "id": "n79-s01-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella camina despacio.", "respuestas": ["She walks slowly."], "explicacion": "verbo + adverbio.", "t": "ej", "id": "n79-s01-e04"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él habla rápido.", "respuestas": ["He speaks quickly."], "explicacion": "verbo + adverbio.", "t": "ej", "id": "n79-s01-e05"}, {"t": "teoria", "titulo": "Irregulares", "regla": "good → well. fast → fast y hard → hard no cambian. She sings well. He works hard.", "ejemplos": [{"en": "She sings well.", "es": "Ella canta bien."}, {"en": "He runs fast.", "es": "Él corre rápido."}, {"en": "They work hard.", "es": "Ellos trabajan duro."}], "vocab": []}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: good", "respuestas": ["well"], "explicacion": "good → well.", "t": "ej", "id": "n79-s02-e01"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella canta bien.", "respuestas": ["She sings well."], "explicacion": "good → well.", "t": "ej", "id": "n79-s02-e02"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él corre rápido.", "respuestas": ["He runs fast."], "explicacion": "fast no cambia.", "t": "ej", "id": "n79-s02-e03"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos trabajan duro.", "respuestas": ["They work hard."], "explicacion": "hard no cambia.", "t": "ej", "id": "n79-s02-e04"}, {"t": "teoria", "titulo": "Adjetivo o adverbio", "regla": "Adjetivo describe un sustantivo (a slow man). Adverbio describe un verbo (he walks slowly).", "ejemplos": [{"en": "He is a slow man.", "es": "Él es un hombre lento."}, {"en": "He walks slowly.", "es": "Él camina despacio."}], "vocab": []}, {"tipo": "escribir", "subtipo": "completar", "q": "She is a ___ driver. (careful)", "respuestas": ["careful"], "explicacion": "Adjetivo antes del sustantivo.", "t": "ej", "id": "n79-s03-e01"}, {"tipo": "escribir", "subtipo": "completar", "q": "She drives ___. (careful)", "respuestas": ["carefully"], "explicacion": "Adverbio después del verbo.", "t": "ej", "id": "n79-s03-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "He is a ___ runner. (fast)", "respuestas": ["fast"], "explicacion": "adjetivo.", "t": "ej", "id": "n79-s03-e03"}, {"tipo": "escribir", "subtipo": "completar", "q": "He runs ___. (fast)", "respuestas": ["fast"], "explicacion": "fast = adjetivo y adverbio.", "t": "ej", "id": "n79-s03-e04"}, {"t": "teoria", "titulo": "Evaluación del nivel", "regla": "Combina todo lo aprendido en ADVERBIOS DE MODO. No hay contenido nuevo.", "ejemplos": [], "vocab": []}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él corre rápido.", "respuestas": ["He runs fast."], "explicacion": "fast no cambia.", "t": "ej", "id": "n79-s04-e01"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: slow", "respuestas": ["slowly"], "explicacion": "+ ly.", "t": "ej", "id": "n79-s04-e02"}, {"tipo": "escribir", "subtipo": "completar", "q": "He runs ___. (fast)", "respuestas": ["fast"], "explicacion": "fast = adjetivo y adverbio.", "t": "ej", "id": "n79-s04-e03"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: careful", "respuestas": ["carefully"], "explicacion": "+ ly.", "t": "ej", "id": "n79-s04-e04"}, {"tipo": "escribir", "subtipo": "completar", "q": "She drives ___. (careful)", "respuestas": ["carefully"], "explicacion": "Adverbio después del verbo.", "t": "ej", "id": "n79-s04-e05"}, {"tipo": "escribir", "subtipo": "completar", "q": "He is a ___ runner. (fast)", "respuestas": ["fast"], "explicacion": "adjetivo.", "t": "ej", "id": "n79-s04-e06"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella camina despacio.", "respuestas": ["She walks slowly."], "explicacion": "verbo + adverbio.", "t": "ej", "id": "n79-s04-e07"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ella canta bien.", "respuestas": ["She sings well."], "explicacion": "good → well.", "t": "ej", "id": "n79-s04-e08"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Él habla rápido.", "respuestas": ["He speaks quickly."], "explicacion": "verbo + adverbio.", "t": "ej", "id": "n79-s04-e09"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: good", "respuestas": ["well"], "explicacion": "good → well.", "t": "ej", "id": "n79-s04-e10"}, {"tipo": "escribir", "subtipo": "traducir", "q": "Escribe en inglés: Ellos trabajan duro.", "respuestas": ["They work hard."], "explicacion": "hard no cambia.", "t": "ej", "id": "n79-s04-e11"}, {"tipo": "escribir", "subtipo": "completar", "q": "She is a ___ driver. (careful)", "respuestas": ["careful"], "explicacion": "Adjetivo antes del sustantivo.", "t": "ej", "id": "n79-s04-e12"}, {"tipo": "escribir", "subtipo": "escribir_palabra", "q": "Adverbio de: quick", "respuestas": ["quickly"], "explicacion": "+ ly.", "t": "ej", "id": "n79-s04-e13"}]}
  "secciones": [
    {
      "id": "n02-s01",
      "orden": 1,
      "titulo": "I, you, we",
      "teoria": "En inglés **siempre** se dice el sujeto: I am tired (no «Am tired»). **I** siempre va con mayúscula. **you** = tú, usted o ustedes. **we** = nosotros.",
      "ejemplos": [
        {
          "en": "I am a student.",
          "es": "Soy estudiante."
        },
        {
          "en": "You are happy.",
          "es": "Estás feliz."
        },
        {
          "en": "We are here.",
          "es": "Estamos aquí."
        }
      ],
      "vocabulario": [],
      "ejercicios": [
        {
          "id": "n02-s01-e01",
          "tipo": "completar",
          "enunciado": "___ am tired. (yo)",
          "respuestas": [
            "I"
          ],
          "error": "yo = **I**."
        },
        {
          "id": "n02-s01-e02",
          "tipo": "completar",
          "enunciado": "___ are happy. (tú)",
          "respuestas": [
            "You"
          ],
          "error": "tú = **you**."
        },
        {
          "id": "n02-s01-e03",
          "tipo": "completar",
          "enunciado": "___ are students. (nosotros)",
          "respuestas": [
            "We"
          ],
          "error": "nosotros = **we**."
        },
        {
          "id": "n02-s01-e04",
          "tipo": "escribir_palabra",
          "enunciado": "Escribe el pronombre para: nosotros → ___",
          "respuestas": [
            "we"
          ],
          "error": "nosotros = we."
        },
        {
          "id": "n02-s01-e05",
          "tipo": "traducir",
          "enunciado": "Estoy cansado. = ___",
          "respuestas": [
            "I am tired.",
            "I'm tired."
          ],
          "error": "No se omite el sujeto: I am."
        },
        {
          "id": "n02-s01-e06",
          "tipo": "traducir",
          "enunciado": "Estamos aquí. = ___",

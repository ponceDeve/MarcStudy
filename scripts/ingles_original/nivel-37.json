  "secciones": [
    {
      "id": "n37-s01",
      "orden": 1,
      "titulo": "La tabla",
      "teoria": "Van **después del verbo**: I like her. Cambian así: I → **me**, you → **you**, he → **him**, she → **her**, it → **it**, we → **us**, they → **them**. Verbos nuevos: **love** (amar), **know** (conocer, saber), **see** (ver).",
      "ejemplos": [
        {
          "en": "I like her.",
          "es": "Ella me gusta."
        },
        {
          "en": "She knows me.",
          "es": "Ella me conoce."
        },
        {
          "en": "We love them.",
          "es": "Los queremos."
        }
      ],
      "vocabulario": [],
      "ejercicios": [

      "titulo": "There is / There are",
      "teoria": "**There is** + singular. **There are** + plural. There is a bed. There are two chairs.",
      "ejemplos": [
        {
          "en": "There is a bed.",
          "es": "Hay una cama."
        },
        {
          "en": "There are two chairs.",
          "es": "Hay dos sillas."
        },
        {
          "en": "There is a lamp on the table.",
          "es": "Hay una lámpara sobre la mesa."
        }
      ],
      "vocabulario": [],
      "ejercicios": [
        {

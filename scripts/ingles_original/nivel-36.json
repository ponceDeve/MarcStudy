  "secciones": [
    {
      "id": "n36-s01",
      "orden": 1,
      "titulo": "Verbo + -s",
      "teoria": "Con **he, she, it** el verbo lleva **-s**: I work → he works. I eat → she eats.",
      "ejemplos": [
        {
          "en": "He works here.",
          "es": "Él trabaja aquí."
        },
        {
          "en": "She eats bread.",
          "es": "Ella come pan."
        },
        {
          "en": "He drinks water.",
          "es": "Él bebe agua."
        }
      ],
      "vocabulario": [],
      "ejercicios": [
        {
          "id": "n36-s01-e01",
          "tipo": "completar",
          "enunciado": "He ___ here. (work)",
          "respuestas": [
            "works"
          ],
          "error": "he + verbo + s."
        },
        {
          "id": "n36-s01-e02",

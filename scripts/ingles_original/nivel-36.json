    {
      "id": "n36-s02",
      "orden": 2,
      "titulo": "-es, has",
      "teoria": "Si termina en s, sh, ch, o: **-es** (watch → watches, go → goes). Consonante + y: **-ies** (study → studies). **have → has**.",
      "ejemplos": [
        {
          "en": "She watches TV.",
          "es": "Ella ve televisión."
        },
        {
          "en": "He studies English.",
          "es": "Él estudia inglés."
        },
        {
          "en": "She has a book.",
          "es": "Ella tiene un libro."
        }
      ],
      "vocabulario": [],
      "ejercicios": [

      "id": "n18-s01",
      "orden": 1,
      "titulo": "My y Your",
      "teoria": "**my** = mi (de yo). **your** = tu / su (de you). Van antes del sustantivo: my book, your house.",
      "ejemplos": [
        {
          "en": "My name is Ana.",
          "es": "Mi nombre es Ana."
        },
        {
          "en": "Your book is here.",
          "es": "Tu libro está aquí."
        },
        {
          "en": "It is my bag.",
          "es": "Es mi bolsa."
        }
      ],
      "vocabulario": [],
      "ejercicios": [
        {
          "id": "n18-s01-e01",
          "tipo": "completar",
          "enunciado": "___ name is Ana. (de mí)",
          "respuestas": [
            "My"
          ],
          "error": "yo → **my**."
        },
        {
          "id": "n18-s01-e02",
          "tipo": "completar",
          "enunciado": "___ book is here. (de ti)",
          "respuestas": [
            "Your"
          ],
          "error": "tú → **your**."

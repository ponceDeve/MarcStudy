  "objetivo": "Elegir entre a y an según el sonido de la palabra siguiente.",
  "secciones": [
    {
      "id": "n13-s01",
      "orden": 1,
      "titulo": "A",
      "teoria": "**a** = un/una. Va antes de un sonido de consonante: a book, a dog, a house. Ojo: university empieza con sonido /j/, por eso es a university.",
      "ejemplos": [
        {
          "en": "It is a book.",
          "es": "Es un libro."
        },
        {
          "en": "It is a dog.",
          "es": "Es un perro."
        },
        {
          "en": "It is a university.",
          "es": "Es una universidad."
        }
      ],
      "vocabulario": [],
      "ejercicios": [
